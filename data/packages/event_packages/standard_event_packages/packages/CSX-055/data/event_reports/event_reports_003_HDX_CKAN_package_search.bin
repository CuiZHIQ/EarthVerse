varying\"}, {\"field_name\": \"osm_id\", \"data_type\": \"character varying\"}, {\"field_name\": \"osm_type\", \"data_type\": \"character varying\"}, {\"field_name\": \"building\", \"data_type\": \"character varying\"}, {\"field_name\": \"industrial\", \"data_type\": \"character varying\"}, {\"field_name\": \"access\", \"data_type\": \"character varying\"}, {\"field_name\": \"disused\", \"data_type\": \"character varying\"}, {\"field_name\": \"construction\", \"data_type\": \"character varying\"}, {\"field_name\": \"tower:type\", \"data_type\": \"character varying\"}, {\"field_name\": \"craft\", \"data_type\": \"character varying\"}, {\"field_name\": \"club\", \"data_type\": \"character varying\"}, {\"field_name\": \"addr:place\", \"data_type\": \"character varying\"}, {\"field_name\": \"material\", \"data_type\": \"character varying\"}, {\"field_name\": \"height\", \"data_type\": \"character varying\"}, {\"field_name\": \"min_height\", \"data_type\": \"character varying\"}, {\"field_name\": \"short_name\", \"data_type\": \"character varying\"}, {\"field_name\": \"operator:wikidata\", \"data_type\": \"character varying\"}, {\"field_name\": \"operator:short\", \"data_type\": \"character varying\"}, {\"field_name\": \"fuel:octane_95\", \"data_type\": \"character varying\"}, {\"field_name\": \"fuel:octane_80\", \"data_type\": \"character varying\"}, {\"field_name\": \"fuel:biodiesel\", \"data_type\": \"character varying\"}, {\"field_name\": \"mobile\", \"data_type\": \"character varying\"}, {\"field_name\": \"contact:facebook\", \"data_type\": \"character varying\"}, {\"field_name\": \"addr:state\", \"data_type\": \"character varying\"}, {\"field_name\": \"addr:housename\", \"data_type\": \"character varying\"}, {\"field_name\": \"addr:country\", \"data_type\": \"character varying\"}, {\"field_name\": \"wheelchair\", \"data_type\": \"character varying\"}, {\"field_name\": \"fuel:octane_87_aditivada\", \"data_type\": \"character varying\"}, {\"field_name\": \"fuel:octan