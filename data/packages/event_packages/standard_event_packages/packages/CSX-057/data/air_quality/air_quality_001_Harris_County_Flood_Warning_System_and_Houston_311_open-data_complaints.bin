                    <div class="guideBodyLeftContent">
                        <div class="guideBodyTitle">Inundation</div>
                        <div class="guideBodyInfo">Select Inundation Map to view current flooded roads, parks, and low-lying areas.</div>
                    </div>
                    <div class="guideBodyLeftContent">
                        <div class="guideBodyTitle">Channel Status</div>
                        <div class="guideBodyInfo">Select Channel Status to display current bayou flooding levels.</div>
                    </div>
                    <div>
                        <table style="font-size:8pt;float:right;" class="surfaceLevelLegendBoxItem">
                            <tr><td><div style="margin-right:4px; display:inline-block" class="legendnoFloodCategory"></div>Channel Status not Defined</td></tr>
                            <tr><td><div style="margin-right:4px; display:inline-block" class="legendnoFlooding"></div>No Flooding</td></tr><!--Muru Thangavel updated label from 'Water in Bank' to 'No Flooding' - UserStory#72227-->
                            <tr><td><div style="margin-right:3px;margin-left:-2px; display:inline-block" class="legendsiteWarning"></div>Flooding Possible</td></tr><!--Muru Thangavel updated label from 'Near Top of Bank' to 'Flooding Possible' - UserStory#72227-->
                            <tr><td style="vertical-align:middle;"><div style="margin-right:3px; margin-left:-2px; vertical-align:middle; display:inline-block" class="legendsiteError"></div>Flooding Likely</td></tr><!--Muru Thangavel updated label from 'Out of Bank' to 'Flooding Likely' - UserStory#72227-->
                        </table>
                    </div>
                </div>
            </div>
            <!---->
            <div class="guideBody guideSlide">
                <div class="guideBodyRight">                   
                    <img id="rainFallData" >
                </div>
                <div class="guideBodyLeft">
                    <div class="guideBodyLeftContent">
                        <div class="guideBodyTitle">Rainfall Data</div>
                        <div class="guideBodyInfo">Rainfall data defaults to the last 24 hours. Select the drop down bar to select more time frames.</div>
                    </div>
                    <div class="guideBodyLeftContent">
                        <div class="guideBodyTitle"></div>
                        <div class="guideBodyInfo"></div>
                    </div>
                    <div class="guideBodyLeftContent">
                        <div class="guideBodyTitle"></div>
                        <div class="guideBodyInfo"></div>
                    </div>
                </div>
            </div>
            <!---->
            <div class="guideBody guideSlide">
                <div class="guideBodyRight">                    
                    <img id="siteSelections" >
                </div>
                <div class="guideBodyLeft">
                    <div class="guideBodyLeftContent">
                        <div class="guideBodyTitle">Site Selections</div>
                        <div class="guideBodyInfo">Add more gages in the region using the drop down.</div>
                    </div>
                </div>
            </div>
            <!---->
            <div class="guideBody guideSlide">
                <div class="guideBodyRight">                   
                    <img id="addressSearch" >
                </div>
                <div class="guideBodyLeft">
                    <div class="guideBodyLeftContent">
                        <div class="guideBodyTitle">Address Search</div>
                        <div class="guideBodyInfo">Use the address search to find your nearest gage.</div>
                    </div>
                </div>
            </div>
            <!---->
            <div class="guideBody guideSlide">
                <div class="guideBodyRight">                   
                    <img id="siteDetailsPage">
                </div>
                <div class="guideBodyLeft">
                    <div class="guideBodyLeftContent">
                        <div class="guideBodyTitle">Site Details Page</div>
                        <div class="guideBodyInfo">Hover mouse over any site and click the more information link to view water level and rainfall data. Custom and default rainfall and water level alerts are available for each site.</div>
                    </div>
                </div>
            </div>
            <!---->
            <div class="guideBody guideSlide">
                <div class="guideBodyRight">
                </div>
                <div class="guideBodyLeft">
                    <div class="guideBodyLeftContent">
                        <div class="guideBodyTitle">Get notified when it is flooding! </div>
                        <div class="guideBodyInfo">Sign up to receive rainfall and water level alerts via text message and email.</div>
                    </div>
                </div>
            </div>
            <!---->
        </div>
        <div class="guideFooter">
            <ul>
                <li><a class="prev" onclick="hcfcd.guide.plusSlides(-1)">&#10094;</a></li>
                <li>
                    <div class="guideDots">
                        <span class="guideDot" onclick="hcfcd.guide.show(1)"></span>
                        <span class="guideDot" onclick="hcfcd.guide.show(2)"></span>
                        <span class="guideDot" onclick="hcfcd.guide.show(3)"></span>
                        <span class="guideDot" onclick="hcfcd.guide.show(4)"></span>
                        <span class="guideDot" onclick="hcfcd.guide.show(5)"></span>
                        <span class="guideDot" onclick="hcfcd.guide.show(6)"></span>
                    </div>
                </li>
                <li><a class="next" onclick="hcfcd.guide.plusSlides(1)">&#10095;</a></li>
            </ul>
            <div class="guideCloseBtn">
                Close <span class="k-icon k-i-close-outline"></span>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
        $(document).ready(function () {
            hcfcd.guide.init("showIndexGuide", function()
            {
                // We are showing the guide so hide the map widgets
                $(".MicrosoftMap .NavBar_Container").hide();

                var items = $("#fws-menu").find(".k-link").parent();
                var kmenu = $("#fws-menu").data("kendoMenu");
                if(kmenu)
                    kmenu.enable(items, false);
            }, function()
            {
                // We are hiding the guide so show the map widgets
                $(".MicrosoftMap .NavBar_Container").show();

                var items = $("#fws-menu").find(".k-link").parent();
                var kmenu = $("#fws-menu").data("kendoMenu");
                if(kmenu)
                    kmenu.enable(items, true);
            });
        });
</script>

    <style>
        .MicrosoftMap .NavBar_Container { display: none; }
    </style>

</body>

</html>