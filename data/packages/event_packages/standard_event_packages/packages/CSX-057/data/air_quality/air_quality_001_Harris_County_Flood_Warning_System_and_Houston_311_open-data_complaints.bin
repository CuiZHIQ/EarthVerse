                .noUi-background.noUi-vertical {
                    height: 200px;
                    width: 8px;
                    margin: 0 auto 30px;
                }

                .noUi-base .noUi-connect {
                    background-color: #135a8e;
                }

                .noUi-base .noUi-handle {
                    background-color: #1977bb;
                    border: none;
                    border-radius: 3px;
                    box-shadow: none;
                    color: #FFFFFF;
                    display: table;
                    font-size: 15px;
                    height: 12px;
                    left: 0;
                    margin-left: -4px;
                    margin-top: -4px;
                    padding: 0;
                    position: absolute;
                    text-align: center;
                    top: 0;
                    width: 8px;
                    z-index: 2;
                }

                html:not([dir=rtl]) .noUi-horizontal .noUi-handle {
                    right: -4px;
                }

                .noUi-horizontal .noUi-base .noUi-handle {
                    cursor: ew-resize;
                }

                .noUi-vertical .noUi-base .noUi-handle {
                    cursor: ns-resize;
