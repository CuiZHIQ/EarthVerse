<link href="/lib/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" />
<style>
    .k-menu.k-header {
        background-color: transparent;
    }

    .k-menu .k-popup {
        background-color: #0c5480;
    }

    .k-menu .k-item {
        color: white;
    }

    .k-popup .k-item {
        /*cursor: default;*/
    }

    .k-menu .k-link:link {
        color: white;
    }

    .k-menu .k-state-hover > .k-state-active {
        background-color: #0c5480;
    }

    .k-mediaplayer-toolbar .k-button.k-bare:active,
    .k-mediaplayer-toolbar .k-button.k-bare.k-state-active,
    .k-mediaplayer-toolbar .k-button.k-bare.k-state-active:hover {
        color: white;
    }

    .k-menu .k-state-selected > .k-link {
        color: #555555;
        background-color: #555555;
        border-color: #585858;
    }

    .k-menu .k-link {
        color: white;
    }

        .k-menu .k-link.k-state-active {
            background-color: #0c5480;
            border-color: #a3d0e4;
            color: white;
        }

    #fws-menu .k-link.k-state-active {
        background-color: #0c5480;
        border-color: #a3d0e4;
        color: white;
    }


    .k-menu .k-link.k-state-active .k-animation-container ul {
        background-color: #0c5480;
        border-color: #5a5a5a;
        color: white;
    }

    .k-menu .k-state-hover > .k-link,
    .k-menu .k-menu-scroll-button:hover {
        color: white;
        background-color: #555555; /*#0c5480; set this on k-animation-container 2nd child */
        border-color: #585858;
        background-image: none;
    }

    #fws-menu {
        border: 0;
        background-image: none;
        font: bold 12px helvetica;
    }

    #loginMenu {
        position: absolute;
        top: 8px;
        right: 140px;
    }

    .k-menu-horizontal > .k-item.k-last {
        border: 0;
    }

    .newMenuItem::before {
        content: "New";
        position: absolute;
        top: -4px;
        right: 3px;
        font: bold 11px helvetica;
        color: #fbb047;
    }

    ul .k-group.k-menu-group.k-popup.k-reset li {
    }

    .sprite.login {
        background-position: -755px -133px;
        width: 14px;
        height: 18px;
    }

    .sprite.profile {
        background-position: -774px -133px;
        width: 15px;
        height: 19px;
    }

    #fws-menu:nth-child(2) .k-animation-container ul li,
    #fws-menu:nth-child(2) .k-animation-container ul li a:hover,
    #fws-menu:nth-child(2) .k-animation-container ul li:active span
    /* Alerts dropdown set hover to #0c5480 */ {
        background-color: #0c5480;
    }

        #fws-menu:nth-child(2) .k-animation-container ul li a {
            margin-top: 6px;
            float: left;
            background-color: #0c5480;
            overflow: hidden;
            /*border: 1px solid green;*/
        }

    #template img {
        margin: 0;
        float: left;
    }

    #template {
        position: relative;
        float: left;
        display: block;
        width: 376px;
        padding: 0px 30px 20px 40px;
        margin: -2px -20.5px 0 -9.5px; /* key margin settings to prevent display of grey background on parent li */
        overflow-y: hidden;
        box-sizing: border-box;
        background-color: #0c5480;
        font: bold 12px Helvetica;
        cursor: default;
        /*border: 1px solid red;*/
    }

        #template ul {
            position: relative;
            float: left;
            list-style-type: none;
            display: inline-block;
            margin: 0;
            padding: 0;
            padding-top: 10px;
            margin-top: -4px;
            margin-bottom: 20px;
            width: 98%;
            background-color: #0c5480;
            font: bold 12px Helvetica;
            /*border: 2px solid pink;*/
        }

            #template ul li {
                position: relative;
                float: left;
                display: block;
                height: 38px;
                line-height: 1.2em;
                background-color: #0c5480;
                color: white;
                margin: 0;
                padding: 0;
                width: 99%;
                cursor: default;
                box-sizing: border-box;
                /*border: 1px solid yellow;*/
            }

                #template ul li span {
                    position: relative;
                    float: left;
                    display: block;
                    background-color: #0c5480;
                }

                #template ul li a, #template ul li, #template h3 {
                    text-decoration: none;
                    outline: none;
                    line-height: 1.3em;
                    color: #FFF;
                    background-color: #0c5480;
                    /*text-shadow: 1px 1px 1px #000;*/
                }

                    #template ul li a {
                        color: #FFF;
                        /*text-shadow: 1px 1px 1px #000;*/
                        cursor: unset;
                        cursor: pointer;
                    }

                    #template ul li a {
                        font-family: 11px Helvetica, sans-serif bold;
                    }

                        #template ul li a:hover h3 {
                            color: #fbb047;
                        }

        #template:after {
            content: ".";
            display: block;
            height: 0;
            clear: both;
            visibility: hidden;
        }

        #template .k-button {
            float: left;
            clear: left;
            margin: 5px 0 5px 12px;
        }
</style>



<ul class="navbar-nav mr-auto" id="fws-menu" style="position:absolute;z-index:70001"></ul>
<script>
    var baseReturnUrl = "/";
    var qParams = "";
    if (qParams != null && qParams != "" && qParams.indexOf("returnUrl") == -1)
    {
        qParams = qParams.replace("+", " ").replace("&amp;", "%26");
        baseReturnUrl = baseReturnUrl + "?" + qParams;
    }

    function LoginRegister(reg){
        var rUrl = "/" + window.location.search;
        var CurUrl = window.location.pathname.split("/");
        var controller = CurUrl[1];
        history.pushState("CurrentUrl",controller, rUrl);
        if (reg === 1)
            window.location.replace("/Account/Register?returnUrl=" + encodeURIComponent(rUrl + '&nr=y'));
        else
            window.location.replace("/Account/Login?returnUrl=" + encodeURIComponent(rUrl));
    }
    $(document).ready(function () {

        var isLogedIn = false;
        var userHandle = '';
        var signupSubMenu1 = "<h3 style='margin-bottom: 5px;'><span style='color: #fbb047'>NEW! FWS now has Alerts!  </span> <br />Get Rainfall or Water Level alerts <br />by text or email.</h3>";
        var createAccount = "<a href='javascript:LoginRegister(1);'><h3><i class='fa fa-user-circle'></i> Create an account</h3></a>";
        var login = "<a href='javascript:LoginRegister(0);'><h3><i class='fa fa-sign-in' aria-hidden='true'></i> Login</h3></a>";
        var haveQuetion = "<a href='/FAQs'><h3><i class='fa fa-question-circle'></i>&nbsp;Have questions?</h3></a>";
        var siteSignUp = "<a href='/MultiGauge'><h3><i class='fa fa-exclamation-triangle'></i>&nbsp;Click Here for Site Sign Up</h3></a>";

        var signupSubMenu2 = isLogedIn ? "<li>" + siteSignUp + "</li>" : "<li>" + createAccount + "</li>" +  "<li>" + login + "</li>";
        var qString = 'redirect_uri=' + 'https://www.harriscountyfws.org/' + '&callback_uri=' + 'https://www.harriscountyfws.org/';
        var editProfileUrl = 'https://cloudidentity.harriscountytx.gov' + '/Account/EditProfile?returnUrl=' + encodeURIComponent(qString);

        var mainMenuConfig = [
            { text: "FWS MAP", url: "/" },
            {
                spriteCssClass: "newMenuItem",
                text: "ALERTS SIGNUP",
                url: "/MultiGauge",
                items: [
                    { text: "<div id='template' style='letter-spacing: 1.5px'>" +
                                signupSubMenu1+
                                "<ul>" +
                                     signupSubMenu2 +
                                    "<li>" + haveQuetion + "</li>" +
                                "</ul>" +
                            "</div>",
                        encoded:false
                    }
                ]
            },
            {
                text: "DOCUMENT LIBRARY", url: "/Document_Library"
            },
            {
                text: "ABOUT FWS",
                url: "/About",
                items: [
                    { text: "Glossary", url: "/Glossary" },
                    { text: "FAQs", url: "/FAQs" },
                    { text: "Contact Us", url: "/ContactUs" },
                    { text: "Helpful Resources", url: "/Helpful_Resources" },
                    { text: "Help", url: "/Help" },
                ]
            },
        ];

        var profileMenuConfig = [];
        if (!isLogedIn) {
            profileMenuConfig.push({
                text: "LOGIN/REGISTER",
                url: "/Account/Login?returnUrl=" + baseReturnUrl, spriteCssClass: "sprite login" })
        } else {
            profileMenuConfig.push({
                text: userHandle,   spriteCssClass: "sprite profile" ,
                items: [
                    { text: 'Account Profile', url: "/Account/EditProfile?returnUrl=" + encodeURIComponent(baseReturnUrl)},
                    { text: "Logout", url: "/Account/LogOut?returnUrl=" + encodeURIComponent(baseReturnUrl)},
                ],
                encoded:false
            })
        }


        $("#fws-menu").kendoMenu({
            dataSource: mainMenuConfig,
            select: function (e) {
                //google tracking should be here
            }
        })



        function getUrlPart(str, key) {
            return str.split(key)[1];
        }

        $("#loginMenu").kendoMenu({
            dataSource: profileMenuConfig,
            select: function(e) {
                //Stuff
                if($(e.item).children(".k-link").text()=="LOGIN/REGISTER" || $(e.item).children(".k-link").text().toUpperCase()=="ACCOUNT PROFILE" || $(e.item).children(".k-link").text().toUpperCase()=="LOGOUT"){
                    var CurUrl = window.location.pathname.split("/");
                    var controller = CurUrl[1];
                    if(controller=="MultiGauge"){
                        //var menu = e.sender.options.dataSource;
                        //var retUrl = getUrlPart(menu[0]["url"],'returnUrl=');
                        if(typeof returnUrl!="undefined" && returnUrl!=''){
                            if (e.preventDefault)
                                e.preventDefault();

                            if($(e.item).children(".k-link").text()=="LOGIN/REGISTER")
                            {
                                history.pushState("CurrentUrl","MultiGauge", returnUrl);
                                window.location.replace("/Account/Login?returnUrl=" + encodeURIComponent(returnUrl));
                            }
                            else if ($(e.item).children(".k-link").text().toUpperCase()=="LOGOUT")
                            {
                                window.location.replace("/Account/LogOut?returnUrl=" + encodeURIComponent(returnUrl));
                            }
                            else
                            {
                                window.location.replace("/Account/EditProfile?returnUrl=" + encodeURIComponent(returnUrl));
                            }
                        }
                    }
                    else if(controller=="GageDetail"){
                        if(typeof returnUrl!="undefined" && returnUrl!=''){
                            if (e.preventDefault)
                                e.preventDefault();

                            if($(e.item).children(".k-link").text()=="LOGIN/REGISTER")
                            {
                                window.location.replace("/Account/Login?returnUrl=" + encodeURIComponent(returnUrl));
                            }
                            else if ($(e.item).children(".k-link").text().toUpperCase()=="LOGOUT")
                            {
                                window.location.replace("/Account/LogOut?returnUrl=" + encodeURIComponent(returnUrl));
                            }
                            else
                            {
                                window.location.replace("/Account/EditProfile?returnUrl=" + encodeURIComponent(returnUrl));
                            }
                        }
                    }

                }
            }
        })

        if (userHandle == "Hello!") {
            //add tooltip
            $("#loginMenu").kendoTooltip({
                content: "Please complete registration process by providing personal information",
                position: "right"
            })
        }

    });
</script>

                </div>
            </div>
        </div>
