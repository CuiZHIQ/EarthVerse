  <title>CEMS-Floods React</title>

  <!-- Matomo -->
  <script>
    var _paq = window._paq = window._paq || [];
    /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
    window.location.hostname.includes("global") ? _paq.push(["setCookieDomain", "*.globalfloods.eu"]) : _paq.push(["setCookieDomain", "*.efas.eu"]);
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    (function () {
      var u = "//matomo.efas.eu/";
      _paq.push(['setTrackerUrl', u + 'matomo.php']);
      switch (window.location.hostname) {
        case "european-flood.emergency.copernicus.eu":
          _paq.push(['setSiteId', '1']);
          break
        case "stage.efas.eu":
          _paq.push(['setSiteId', '2']);
          break
        case "dev.efas.eu":
          _paq.push(['setSiteId', '3']);
          break
        case "global-flood.emergency.copernicus.eu":
          _paq.push(['setSiteId', '4']);
          break
        case "dev.globalfloods.eu":
          _paq.push(['setSiteId', '5']);
          break
        case "stage.globalfloods.eu":
          _paq.push(['setSiteId', '6']);
          break
        default:
          console.error("Unknown hostname: " + window.location.hostname);
      }
      var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
      g.async = true; g.src = u + 'matomo.js'; s.parentNode.insertBefore(g, s);
    })();
  </script>
  <!-- End Matomo Code -->
