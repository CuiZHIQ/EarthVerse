{"help": "https://data.humdata.org/api/3/action/help_show?name=package_search", "success": true, "result": {"count": 1, "facets": {}, "expanded": {}, "results": [{"archived": true, "caveats": "N/A", "creator_user_id": "b2a22caa-6199-42f7-95ab-adaa5ee0f31e", "data_update_frequency": "-1", "dataset_date": "[2019-10-02T00:00:00 TO 2019-11-09T23:59:59]", "dataset_preview": "first_resource", "dataset_source": "International Organization for Migration (IOM)", "has_geodata": false, "has_showcases": true, "id": "289a451a-8d6a-4211-bfbd-5f7f6afb2897", "is_requestdata_type": false, "isopen": false, "last_modified": "2019-11-26T14:23:50.096565", "license_id": "hdx-other", "license_other": "Copyright \u00a9 International Organization for Migration 2018 IOM reserves the right to assert ownership of the Materials collected on the https://data.humdata.org/ website.\r\n\r\nThe Materials may be viewed, downloaded, and printed for non-commercial use only, without, inter alia, any right to sell, resell, redistribute or create derivative works therefrom. At all times the User shall credit the DTM as the source, unless otherwise stated. The user must include the URL of the Materials from the HDX Website, as well as the following credit line: Source: \u201cInternational Organization for Migration (IOM), Displacement Tracking Matrix (DTM)\u201d.", "license_title": "Other", "maintainer": "65fc1212-7c69-4492-b800-c8f676a9c47e", "metadata_created": "2019-06-21T10:55:45.084624", "metadata_modified": "2025-04-29T12:29:37.823085", "methodology": "Other", "methodology_other": "DTM standard methodology", "name": "mozambique-displacement-data-baseline-assessment-idai-iom-dtm", "notes": "Tropical cyclone Idai, on March 15th 2019, brought torrential rains and winds affecting mostly the provinces of Manica, Sofala and Zamb\u00e9zia, In Mozambique, causing flash flooding and subsequent destruction. This dataset contains DTM assessments containing number of affected people, their needs, geographic locations etc.", "num_resources": 4, "num_tags": 5, "organization": {"id": "f53d32cd-132c-4ef4-bc6d-058f94d08adf", "name": "international-organization-for-migration", "title": "International Organization for Migration (IOM)", "type": "organization", "description": "IOM is committed to the principle that humane and orderly migration benefits migrants and society.\r\n\r\nAs the leading international organization for migration, IOM acts with its partners in the international community to: a) Assist in meeting the growing operational challenges of migration management.\r\nb) Advance understanding of migration issues.\r\nEncourage social and economic development through migration.\r\nc) Uphold the human dignity and well-being of migrants.", "image_url": "", "created": "2014-07-16T13:02:25.371736", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "f53d32cd-132c-4ef4-bc6d-058f94d08adf", "package_creator": "kashifn", "pageviews_last_14_days": 3, "private": false, "qa_completed": false, "solr_additions": "{\"countries\": [\"Mozambique\"]}", "state": "active", "subnational": "1", "title": "Mozambique Displacement Data - Baseline Assessment - Idai - [IOM DTM]", "total_res_downloads": 405, "type": "dataset", "updated_by_script": "HDXPythonLibrary/5.4.1-test (2021-11-17T22:02:06.306144)", "url": null, "version": null, "groups": [{"description": "", "display_name": "Mozambique", "id": "moz", "image_display_url": "", "name": "moz", "title": "Mozambique"}], "resources": [{"alt_url": "https://data.humdata.org/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/adff7da9-3486-40af-849a-c5119b8e0bfd/download/", "cache_last_updated": null, "cache_url": null, "created": "2019-11-26T14:23:50.950270", "datastore_active": false, "description": "Of the 46 resettlement neighborhoods evaluated, most of the neighborhoods with (96%) are located in the Provinces. Sofala, Manica, and Zambezia, with 46,710 people corresponding to 10,831 families; The displaced population remaining in accommodation centers and resettlement neighborhoods is estimated around 54,000 people corresponding to 12,000 families.", "download_url": "https://data.humdata.org/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/adff7da9-3486-40af-849a-c5119b8e0bfd/download/dtm-mozambique-baseline-assessment-round-6.xlsx", "format": "XLSX", "hash": "", "hdx_rel_url": "/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/adff7da9-3486-40af-849a-c5119b8e0bfd/download/dtm-mozambique-baseline-assessment-round-6.xlsx", "id": "adff7da9-3486-40af-849a-c5119b8e0bfd", "last_modified": "2019-11-26T14:23:50.096565", "metadata_modified": "2025-04-08T18:28:47.438137", "microdata": false, "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "mimetype_inner": null, "name": "DTM Mozambique Baseline Assessment Round 6", "originalHash": "1116936704", "p_coded": true, "package_id": "289a451a-8d6a-4211-bfbd-5f7f6afb2897", "position": 0, "resource_type": "file.upload", "size": 1887445, "state": "active", "url": "https://data.humdata.org/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/adff7da9-3486-40af-849a-c5119b8e0bfd/download/dtm-mozambique-baseline-assessment-round-6.xlsx", "url_type": "upload"}, {"": "x", "alt_url": "https://data.humdata.org/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/440afc35-c16b-4a44-8cf9-d8b00183098e/download/", "cache_last_updated": null, "cache_url": null, "created": "2019-09-17T10:48:36.598241", "datastore_active": false, "description": "- An estimated 1,261 households and 7,730 individuals left their assessed locality to another district;\n- More than 2,000,000 people whose homes were affected by shelter damage have stayed inside their locality;\n- In Sofala and Zambezia reported a displaced population who have not returned to their locality of origin estimated at around 17,000 individuals and 4,000 households;\n- The number of returned population who have returned to their locality of origin represents nearly 10,000 people and around 2,000 households.", "download_url": "https://data.humdata.org/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/440afc35-c16b-4a44-8cf9-d8b00183098e/download/dtm-mozambique-baseline-assessment-round-5.xlsx", "format": "XLSX", "hash": "", "hdx_rel_url": "/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/440afc35-c16b-4a44-8cf9-d8b00183098e/download/dtm-mozambique-baseline-assessment-round-5.xlsx", "id": "440afc35-c16b-4a44-8cf9-d8b00183098e", "last_modified": "2019-09-17T10:48:36.118638", "metadata_modified": "2025-04-08T18:28:47.943655", "microdata": false, "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "mimetype_inner": null, "name": "DTM Mozambique Baseline Assessment Round 5", "originalHash": "1986895357", "p_coded": true, "package_id": "289a451a-8d6a-4211-bfbd-5f7f6afb2897", "position": 1, "resource_type": "file.upload", "size": 129881, "state": "active", "url": "https://data.humdata.org/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/440afc35-c16b-4a44-8cf9-d8b00183098e/download/dtm-mozambique-baseline-assessment-round-5.xlsx", "url_type": "upload"}, {"": "x", "alt_url": "https://data.humdata.org/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/54db2f8f-2d18-4312-b39e-271b08b11066/download/", "cache_last_updated": null, "cache_url": null, "created": "2019-06-21T10:55:46.753154", "datastore_active": false, "description": "From 27 May to 3 June, in close coordination with Mozambique\u2019s INGC, IOM DTM teams conducted baseline assessments at locality level. The assessment covered 19 districts in Sofala,\nManica, Tete and Zambezia provinces. There are 334+ K households and more than 1.5M affected individuals.", "download_url": "https://data.humdata.org/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/54db2f8f-2d18-4312-b39e-271b08b11066/download/dtm-mozambique-baseline-assessment-round-2.xlsx", "format": "XLSX", "hash": "", "hdx_rel_url": "/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/54db2f8f-2d18-4312-b39e-271b08b11066/download/dtm-mozambique-baseline-assessment-round-2.xlsx", "id": "54db2f8f-2d18-4312-b39e-271b08b11066", "last_modified": "2019-09-11T16:37:58.154011", "metadata_modified": "2025-04-08T18:28:52.455054", "microdata": false, "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "mimetype_inner": null, "name": "DTM Mozambique Baseline Assessment Round 2", "originalHash": "-1732295092", "p_coded": true, "package_id": "289a451a-8d6a-4211-bfbd-5f7f6afb2897", "position": 2, "resource_type": "file.upload", "size": 59152, "state": "active", "url": "https://data.humdata.org/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/54db2f8f-2d18-4312-b39e-271b08b11066/download/dtm-mozambique-baseline-assessment-round-2.xlsx", "url_type": "upload"}, {"": "x", "alt_url": "https://data.humdata.org/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/e18a7153-405a-4487-80b2-97e370e46816/download/", "cache_last_updated": null, "cache_url": null, "created": "2019-06-21T10:55:49.511532", "datastore_active": false, "description": "", "download_url": "https://data.humdata.org/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/e18a7153-405a-4487-80b2-97e370e46816/download/dtm-mozambique-baseline-assessment-round-1.xlsx", "format": "XLSX", "hash": "", "hdx_rel_url": "/dataset/289a451a-8d6a-4211-bfbd-5f7f6afb2897/resource/e18a7153-405a-4487-80b2-97e370e46816/download/dtm-mozambique-baseline-assessment-round-1.xlsx", "id": "e18a7153-405a-4487-80b2-97e370e46816", "last_modified": "2019-06-21T10:55:49.043932", "metadata_modified": "2025-04-08T18:28:53.072009", "microdata": false, "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "mimetype_inner": null, "name": "DTM Mozambique Baseline Assessment Round 1", "originalHash": "1116936704", "p_coded": true, "package_id": "289a451a-8d6a-4211-bfbd-5f7f6afb2897", "position": 3, "resource_type": "file.upload", "size": 33799, "state