{"help": "https://data.humdata.org/api/3/action/help_show?name=package_search", "success": true, "result": {"count": 5, "facets": {}, "expanded": {}, "results": [{"archived": false, "batch": "e5a61aa5-f87a-47f1-bbfa-dc9ff8885225", "caveats": "Variations in the vegetation health and/or cover could be related to stress factors not related to droughts (e.g., plant diseases, pests, hail, flooding). To determine if changes in FAPAR are linked with a drought event or not, FAPAR data should be interpreted jointly with other indicators (as in the EDO Combined Drought Indicator).", "creator_user_id": "1a008a13-52b1-4326-a9ea-aa541372577c", "data_update_frequency": "30", "dataset_date": "[2012-01-21T00:00:00 TO 2026-04-30T23:59:59]", "dataset_preview": "first_resource", "dataset_source": "European Commission, Joint Research Centre (JRC)", "due_date": "2026-05-30T23:59:59", "has_geodata": true, "has_showcases": false, "id": "6959935c-131f-4dc0-9e46-4e98eb54d3c1", "is_requestdata_type": false, "isopen": true, "last_modified": "2026-05-18T07:50:42.610361", "license_id": "cc-by", "license_title": "Creative Commons Attribution International (CC BY)", "license_url": "http://www.opendefinition.org/licenses/cc-by", "maintainer": "aa13de36-28c5-47a7-8d0b-6d7c754ba8c8", "metadata_created": "2025-07-23T15:42:17.691767", "metadata_modified": "2026-05-18T07:50:44.931125", "methodology": "Other", "methodology_other": "FAPAR and FAPAR anomalies datasets come as raster files for every 10-day interval. The deviation of the FAPAR values from the long-term mean (anomaly) are calculated at each spatial location (grid-cell), with a reference baseline that ranges from the year 2012 to the last available full year (see Section 3). Negative FAPAR anomalies suggest conditions of relative vegetation stress, especially plant water stress due to drought, during that 10-day interval. In contrast, positive FAPAR anomalies indicate relatively favorable vegetation growth conditions during that 10-day interval.  \n[More information](https://drought.emergency.copernicus.eu/data/factsheets/factsheet_fapar_viirs.pdf)", "name": "mac-anomalies-fapar-viirs", "notes": "Fraction of Absorbed Photosynthetically Active Radiation (FAPAR) is a biophysical dimensionless quantity (its values range from 0/no absorption to 1/total absorption) used to assess the greenness and health of vegetation. FAPAR anomalies can be used as an indicator to detect and monitor the impacts of agricultural drought on the growth and productivity of vegetation.  \n  \nThe data is presented in 10-day time composite of the Visible Infrared Imaging Radiometer Suite (VIIRS).", "num_resources": 15, "num_tags": 2, "organization": {"id": "47677055-92e2-4f68-bf1b-5d570f27e791", "name": "copernicus", "title": "Copernicus", "type": "organization", "description": "Copernicus is the Earth observation component of the European Union\u2019s Space programme. It offers information services that draw from satellite Earth Observation and in-situ (non-space) data.\r\nIt sets out to fulfil the growing need amongst European policy- makers, businesses, scientists and individuals to access timely accurate information services. By delivering vast amounts of Earth observation data through a unified system, this innovative programme starts a new chapter in the way we manage the environment, understand and mitigate the effects of climate change and ensure civil security for a safer and more sustainable future.", "image_url": "", "created": "2024-10-15T08:45:05.455885", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "47677055-92e2-4f68-bf1b-5d570f27e791", "package_creator": "HDX Data Systems Team", "pageviews_last_14_days": 1, "private": false, "qa_completed": false, "solr_additions": "{\"countries\": [\"China, Macao Special Administrative Region\"]}", "state": "active", "subnational": "1", "title": "China, Macao Special Administrative Region: Copernicus Vegetation Index Anomaly (FAPAR Anomaly)", "total_res_downloads": 51, "type": "dataset", "updated_by_script": "HDX Scraper: copernicus (2026-05-18T07:50:42.554861)", "url": null, "version": null, "groups": [{"description": "", "display_name": "China, Macao Special Administrative Region", "id": "mac", "image_display_url": "", "name": "mac", "title": "China, Macao Special Administrative Region"}], "resources": [{"alt_url": "https://data.humdata.org/dataset/6959935c-131f-4dc0-9e46-4e98eb54d3c1/resource/b0e8f564-e7df-4173-add6-f45ac8d0a769/download/", "cache_last_updated": null, "cache_url": null, "created": "2026-05-18T07:50:42.729753", "datastore_active": false, "description": "Data from 2026-01-01 to 2026-04-30", "download_url": "https://data.humdata.org/dataset/6959935c-131f-4dc0-9e46-4e98eb54d3c1/resource/b0e8f564-e7df-4173-add6-f45ac8d0a769/download/mac_fpanv_m_gdo_20260101_20260421_t.zip", "format": "GeoTIFF", "hash": "985ab8b3", "hdx_rel_url": "/dataset/6959935c-131f-4dc0-9e46-4e98eb54d3c1/resource/b0e8f564-e7df-4173-add6-f45ac8d0a769/download/mac_fpanv_m_gdo_20260101_20260421_t.zip", "id": "b0e8f564-e7df-4173-add6-f45ac8d0a769", "last_modified": "2026-05-18T07:50:42.610361", "metadata_modified": "2026-05-18T07:50:43.964976", "microdata": false, "mimetype": "application/zip", "mimetype_inner": null, "name": "mac_fpanv_m_gdo_20260101_20260421_t.zip", "package_id": "6959935c-131f-4dc0-9e46-4e98eb54d3c1", "position": 0, "resource_type": "file.upload", "size": 8185, "state": "active", "url": "https://data.humdata.org/dataset/6959935c-131f-4dc0-9e46-4e98eb54d3c1/resource/b0e8f564-e7df-4173-add6-f45ac8d0a769/download/mac_fpanv_m_gdo_20260101_20260421_t.zip", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/6959935c-131f-4dc0-9e46-4e98eb54d3c1/resource/c434c240-d1c1-4451-ad79-c6961c88b60d/download/", "cache_last_updated": null, "cache_url": null, "created": "2026-01-12T07:54:41.960597", "datastore_active": false, "description": "Data from 2025-01-01 to 2025-12-31", "download_url": "htt