20130101_20131221_t.zip", "package_id": "2322a7be-4883-4e57-8566-f91c78e93830", "position": 13, "resource_type": "file.upload", "size": 15421883, "state": "active", "url": "https://data.humdata.org/dataset/2322a7be-4883-4e57-8566-f91c78e93830/resource/a1369cc2-0afe-4baa-bd7c-ee26d0389825/download/chn_fpanv_m_gdo_20130101_20131221_t.zip", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/2322a7be-4883-4e57-8566-f91c78e93830/resource/4910e7ef-4ed0-4d2b-9c13-6f427df92f60/download/", "cache_last_updated": null, "cache_url": null, "created": "2025-07-23T15:05:22.577985", "datastore_active": false, "description": "Data from 2012-01-21 to 2012-12-31", "download_url": "https://data.humdata.org/dataset/2322a7be-4883-4e57-8566-f91c78e93830/resource/4910e7ef-4ed0-4d2b-9c13-6f427df92f60/download/chn_fpanv_m_gdo_20120121_20121221_t.zip", "format": "GeoTIFF", "hash": "", "hdx_rel_url": "/dataset/2322a7be-4883-4e57-8566-f91c78e93830/resource/4910e7ef-4ed0-4d2b-9c13-6f427df92f60/download/chn_fpanv_m_gdo_20120121_20121221_t.zip", "id": "4910e7ef-4ed0-4d2b-9c13-6f427df92f60", "last_modified": "2025-07-23T15:05:33.176773", "metadata_modified": "2025-07-23T15:05:48.190418", "microdata": false, "mimetype": "application/zip", "mimetype_inner": null, "name": "chn_fpanv_m_gdo_20120121_20121221_t.zip", "package_id": "2322a7be-4883-4e57-8566-f91c78e93830", "position": 14, "resource_type": "file.upload", "size": 14426754, "state": "active", "url": "https://data.humdata.org/dataset/2322a7be-4883-4e57-8566-f91c78e93830/resource/4910e7ef-4ed0-4d2b-9c13-6f427df92f60/download/chn_fpanv_m_gdo_20120121_20121221_t.zip", "url_type": "upload"}], "tags": [{"display_name": "drought", "id": "34a5c9d1-5554-4f9e-91fa-5983f0c9a721", "name": "drought", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "environment", "id": "71e54185-e2ea-4dd0-b67d-8316abefe82b", "name": "environment", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}], "relationships_as_subject": [], "relationships_as_object": []}, {"archived": false, "batch": "e5a61aa5-f87a-47f1-bbfa-dc9ff8885225", "caveats": "Variations in the vegetation health and/or cover could be related to stress factors not related to droughts (e.g., plant diseases, pests, hail, flooding). To determine if changes in FAPAR are linked with a drought event or not, FAPAR data should be interpreted jointly with other indicators (as in the EDO Combined Drought Indicator).", "creator_user_id": "1a008a13-52b1-4326-a9ea-aa541372577c", "data_update_frequency": "30", "dataset_date": "[2012-01-21T00:00:00 TO 2026-04-30T23:59:59]", "dataset_preview": "first_resource", "dataset_source": "European Commission, Joint Research Centre (JRC)", "due_date": "2026-05-30T23:59:59", "has_geodata": true, "has_showcases": false, "id": "e10e47e9-b757-4a10-8940-5ee752d4442b", "is_requestdata_type": false, "isopen": true, "last_modified": "2026-05-18T07:55:03.260122", "license_id": "cc-by", "license_title": "Creative Commons Attribution International (CC BY)", "license_url": "http://www.opendefinition.org/licenses/cc-by", "maintainer": "aa13de36-28c5-47a7-8d0b-6d7c754ba8c8", "metadata_created": "2025-07-23T16:20:48.061563", "metadata_modified": "2026-05-18T07:55:05.192132", "methodology": "Other", "methodology_other": "FAPAR and FAPAR anomalies datasets come as raster files for every 10-day interval. The deviation of the FAPAR values from the long-term mean (anomaly) are calculated at each spatial location (grid-cell), with a reference baseline that ranges from the year 2012 to the last available full year (see Section 3). Negative FAPAR anomalies suggest conditions of relative vegetation stress, especially plant water stress due to drought, during that 10-day interval. In contrast, positive FAPAR anomalies indicate relatively favorable vegetation growth conditions during that 10-day interval.  \n[More information](https://drought.emergency.copernicus.eu/data/factsheets/factsheet_fapar_viirs.pdf)", "name": "twn-anomalies-fapar-viirs", "notes": "Fraction of Absorbed Photosynthetically Active Radiation (FAPAR) is a biophysical dimensionless quantity (its values range from 0/no absorption to 1/total absorption) used to assess the greenness and health of vegetation. FAPAR anomalies can be used as an indicator to detect and monitor the impacts of agricultural drought on the growth and productivity of vegetation.  \n  \nThe data is presented in 10-day time composite of the Visible Infrared Imaging Radiometer Suite (VIIRS).", "num_resources": 15, "num_tags": 2, "organization": {"id": "47677055-92e2-4f68-bf1b-5d570f27e791", "name": "copernicus", "title": "Copernicus", "type": "organization", "description": "Copernicus is the Earth observation component of the European Union\u2019s Space programme. It offers information services that draw from satellite Earth Observation and in-situ (non-space) data.\r\nIt sets out to fulfil the growing need amongst European policy- makers, businesses, scientists and individuals to access timely accurate information services. By delivering vast amounts of Earth observation data through a unified system, this innovative programme starts a new chapter in the way we manage the environment, understand and mitigate the effects of climate change and ensure civil security for a safer and more sustainable future.", "image_url": "", "created": "2024-10-15T08:45:05.455885", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "47677055-92e2-4f68-bf1b-5d570f27e791", "package_creator": "HDX Data Systems Team", "pageviews_last_14_days": 1, "private": false, "qa_completed": false, "solr_additions": "{\"countries\": [\"Taiwan (Province of China)\"]}", "state": "active", "subnational": "1", "title": "Taiwan (Province of China): Copernicus Vegetation Index Anomaly (FAPAR Anomaly)", "total_res_downloads": 60, "type": "dataset", "updated_by_script": "HDX Scraper: copernicus (2026-05-18T07:55:03.199249)", "url": null, "version": null, "groups": [{"description": "", "display_name": "Taiwan (Province of China)", "id": "twn", "image_display_url": "", "name": "twn", "title": "Taiwan (Province of China)"}], "resources": [{"alt_url": "https://data.humdata.org/dataset/e10e47e9-b757-4a10-8940-5ee752d4442b/resource/676fe145-bee8-476e-9a3d-b142a65750e0/download/", "cache_last_updated": null, "cache_url": null, "created": "2026-05-18T07:55:03.368541", "datastore_active": false, "description": "Data from 2026-01-01 to 2026-04-30", "download_url": "https://data.humdata.org/dataset/e10e47e9-b757-4a10-8940-5ee752d4442b/resource/676fe145-bee8-476e-9a3d-b142a65750e0/download/twn_fpanv_m_gdo_20260101_20260421_t.zip", "format": "GeoTIFF", "hash": "2fb9ed1c", "hdx_rel_url": "/dataset/e10e47e9-b757-4a10-8940-5ee752d4442b/resource/676fe145-bee8-476e-9a3d-b142a65750e0/download/twn_fpanv_m_gdo_20260101_20260421_t.zip", "id": "676fe145-bee8-476e-9a3d-b142a65750e0", "last_modified": "2026-05-18T07:55:03.260122", "metadata_modified": "2026-05-18T07:55:04.277443", "microdata": false, "mimetype": "application/zip", "mimetype_inner": null, "name": "twn_fpanv_m_gdo_20260101_20260421_t.zip", "package_id": "e10e47e9-b757-4a10-8940-5ee752d4442b", "position": 0, "resource_type": "file.upload", "size": 30828, "state": "active", "url": "https://data.humdata.org/dataset/e10e47e9-b757-4a10-8940-5ee752d4442b/resource/676fe145-bee8-476e-9a3d-b142a65750e0/download/twn_fpanv_m_gdo_20260101_20260421_t.zip", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/e10e47e9-b757-4a10-8940-5ee752d4442b/resource/07fa1694-9154-4dd9-8623-c28996567681/download/", "cache_last_updated": null, "cache_url": null, "created": "2026-01-12T08:02:17.431456", "datastore_active": false, "description": "Data from 2025-01-01 to 2025-12-31", "download_url": "https://data.humdata.org/dataset/e10e47e9-b757-4a10-8940-5ee752d4442b/resource/07fa1694-9154-4dd9-8623-c28996567681/download/twn_fpanv_m_gdo_20250101_