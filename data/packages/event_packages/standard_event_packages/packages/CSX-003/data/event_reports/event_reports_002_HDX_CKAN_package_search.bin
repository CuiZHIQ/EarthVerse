11396", "microdata": false, "mimetype": "application/zip", "mimetype_inner": null, "name": "hkg_fpanv_m_gdo_20130101_20131221_t.zip", "package_id": "b73dbf30-f1df-4291-b976-907f032ed343", "position": 13, "resource_type": "file.upload", "size": 22789, "state": "active", "url": "https://data.humdata.org/dataset/b73dbf30-f1df-4291-b976-907f032ed343/resource/428e8d58-0969-403a-acf1-b7fcb200996c/download/hkg_fpanv_m_gdo_20130101_20131221_t.zip", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/b73dbf30-f1df-4291-b976-907f032ed343/resource/1551943a-1dc6-48e0-a63c-7551aee19df8/download/", "cache_last_updated": null, "cache_url": null, "created": "2025-07-23T15:26:41.991806", "datastore_active": false, "description": "Data from 2012-01-21 to 2012-12-31", "download_url": "https://data.humdata.org/dataset/b73dbf30-f1df-4291-b976-907f032ed343/resource/1551943a-1dc6-48e0-a63c-7551aee19df8/download/hkg_fpanv_m_gdo_20120121_20121221_t.zip", "format": "GeoTIFF", "hash": "", "hdx_rel_url": "/dataset/b73dbf30-f1df-4291-b976-907f032ed343/resource/1551943a-1dc6-48e0-a63c-7551aee19df8/download/hkg_fpanv_m_gdo_20120121_20121221_t.zip", "id": "1551943a-1dc6-48e0-a63c-7551aee19df8", "last_modified": "2025-07-23T15:26:52.078306", "metadata_modified": "2025-07-23T15:27:07.911462", "microdata": false, "mimetype": "application/zip", "mimetype_inner": null, "name": "hkg_fpanv_m_gdo_20120121_20121221_t.zip", "package_id": "b73dbf30-f1df-4291-b976-907f032ed343", "position": 14, "resource_type": "file.upload", "size": 21392, "state": "active", "url": "https://data.humdata.org/dataset/b73dbf30-f1df-4291-b976-907f032ed343/resource/1551943a-1dc6-48e0-a63c-7551aee19df8/download/hkg_fpanv_m_gdo_20120121_20121221_t.zip", "url_type": "upload"}], "tags": [{"display_name": "drought", "id": "34a5c9d1-5554-4f9e-91fa-5983f0c9a721", "name": "drought", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "environment", "id": "71e54185-e2ea-4dd0-b67d-8316abefe82b", "name": "environment", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}], "relationships_as_subject": [], "relationships_as_object": []}, {"archived": false, "batch": "e5a61aa5-f87a-47f1-bbfa-dc9ff8885225", "caveats": "Variations in the vegetation health and/or cover could be related to stress factors not related to droughts (e.g., plant diseases, pests, hail, flooding). To determine if changes in FAPAR are linked with a drought event or not, FAPAR data should be interpreted jointly with other indicators (as in the EDO Combined Drought Indicator).", "creator_user_id": "1a008a13-52b1-4326-a9ea-aa541372577c", "data_update_frequency": "30", "dataset_date": "[2012-01-21T00:00:00 TO 2026-04-30T23:59:59]", "dataset_preview": "first_resource", "dataset_source": "European Commission, Joint Research Centre (JRC)", "due_date": "2026-05-30T23:59:59", "has_geodata": true, "has_showcases": false, "id": "2322a7be-4883-4e57-8566-f91c78e93830", "is_requestdata_type": false, "isopen": true, "last_modified": "2026-05-18T07:46:34.759174", "license_id": "cc-by", "license_title": "Creative Commons Attribution International (CC BY)", "license_url": "http://www.opendefinition.org/licenses/cc-by", "maintainer": "aa13de36-28c5-47a7-8d0b-6d7c754ba8c8", "metadata_created": "2025-07-23T15:05:22.571207", "metadata_modified": "2026-05-18T07:46:36.656959", "methodology": "Other", "methodology_other": "FAPAR and FAPAR anomalies datasets come as raster files for every 10-day interval. The deviation of the FAPAR values from the long-term mean (anomaly) are calculated at each spatial location (grid-cell), with a reference baseline that ranges from the year 2012 to the last available full year (see Section 3). Negative FAPAR anomalies suggest conditions of relative vegetation stress, especially plant water stress due to drought, during that 10-day interval. In contrast, positive FAPAR anomalies indicate relatively favorable vegetation growth conditions during that 10-day interval.  \n[More information](https://drought.emergency.copernicus.eu/data/factsheets/factsheet_fapar_viirs.pdf)", "name": "chn-anomalies-fapar-viirs", "notes": "Fraction of Absorbed Photosynthetically Active Radiation (FAPAR) is a biophysical dimensionless quantity (its values range from 0/no absorption to 1/total absorption) used to assess the greenness and health of vegetation. FAPAR anomalies can be used as an indicator to detect and monitor the impacts of agricultural drought on the growth and productivity of vegetation.  \n  \nThe data is presented in 10-day time composite of the Visible Infrared Imaging Radiometer Suite (VIIRS).", "num_resources": 15, "num_tags": 2, "organization": {"id": "47677055-92e2-4f68-bf1b-5d570f27e791", "name": "copernicus", "title": "Copernicus", "type": "organization", "description": "Copernicus is the Earth observation component of the European Union\u2019s Space programme. It offers information services that draw from satellite Earth Observation and in-situ (non-space) data.\r\nIt sets out to fulfil the growing need amongst European policy- makers, businesses, scientists and individuals to access timely accurate information services. By delivering vast amounts of Earth observation data through a unified system, this innovative programme starts a new chapter in the way we manage the environment, understand and mitigate the effects of climate change and ensure civil security for a safer and more sustainable future.", "image_url": "", "created": "2024-10-15T08:45:05.455885", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "47677055-92e2-4f68-bf1b-5d570f27e791", "package_creator": "HDX Data Systems Team", "pageviews_last_14_days": 0, "private": false, "qa_completed": false, "solr_additions": "{\"countries\": [\"China\"]}", "state": "active", "subnational": "1", "title": "China: Copernicus Vegetation Index Anomaly (FAPAR Anomaly)", "total_res_downloads": 67, "type": "dataset", "updated_by_script": "HDX Scraper: copernicus (2026-05-18T07:46:32.963668)", "url": null, "version": null, "groups": [{"description": "", "display_name": "China", "id": "chn", "image_display_url": "", "name": "chn", "title": "China"}], "resources": [{"alt_url": "https://data.humdata.org/dataset/2322a7be-4883-4e57-8566-f91c78e93830/resource/db1c2fbb-9dc8-4350-8c92-afce297173ef/download/", "cache_last_updated": null, "cache_url": null, "created": "2026-05-18T07:46:34.883159", "datastore_active": false, "description": "Data from 2026-01-01 to 2026-04-30", "download_url": "https://data.humdata.org/dataset/2322a7be-4883-4e57-8566-f91c78e93830/resource/db1c2fbb-9dc8-4350-8c92-afce297173ef/download/chn_fpanv_m_gdo_20260101_20260421_t.zip", "format": "GeoTIFF", "hash": "99582149", "hdx_rel_url": "/dataset/2322a7be-4883-4e57-8566-f91c78e93830/resource/db1c2fbb-9dc8-4350-8c92-afce297173ef/download/chn_fpanv_m_gdo_20260101_20260421_t.zip", "id": "db1c2fbb-9dc8-4350-8c92-afce297173ef", "last_modified": "2026-05-18T07:46:34.759174", "metadata_modified": "2026-05-18T07:46:35.915544", "microdata": false, "mimetype": "application/zip", "mimetype_inner": null, "name": "chn_fpanv_m_gdo_20260101_20260421_t.zip", "package_id": "2322a7be-4883-4e57-8566-f91c78e93830", "position": 0, "resource_type": "file.upload", "size": 4332453, "state": "active", "url": "https://data.humdata.org/dataset/2322a7be-4883-4e57-8566-f91c78e93830/resource/db1c2fbb-9dc8-4350-8c92-afce297173ef/download/chn_fpanv_m_gdo_20260101_20260421_t.zip", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/2322a7be-4883-4e57-8566-f91c78e93830/resource/7f398efd-4419-4131-b6f1-6382bf73e92d/download/", "cache_last_updated": null, "cache_url": null, "created": "2026-01-12T07:47:01.633666", "datastore_active": false, "description": "Data from 2025-01-01 to 2025-12-31", "download_url": "https://data.humdata.org/dataset/2322a7be-4883-4e57-8566-f91c78e93830/resource/7f398efd-4419-4131-b6f1-6382bf73e92d/download/chn_f