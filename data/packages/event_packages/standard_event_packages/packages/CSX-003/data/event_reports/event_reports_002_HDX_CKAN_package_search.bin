s_object": []}, {"archived": false, "batch": "a263d540-5503-4ed5-adfa-b0187cb9fd57", "creator_user_id": "6bf7b9d7-7fee-4663-8d7a-4122977f6756", "data_update_frequency": "-1", "dataset_date": "[2016-09-01T00:00:00 TO 2023-03-24T23:59:59]", "dataset_preview": "first_resource", "dataset_source": "Facebook", "has_geodata": false, "has_showcases": false, "id": "8bd3d109-d33d-4349-90c4-464c9d7ccb66", "is_requestdata_type": false, "isopen": true, "last_modified": "2026-05-11T13:18:27.275321", "license_id": "cc-by", "license_title": "Creative Commons Attribution International (CC BY)", "license_url": "http://www.opendefinition.org/licenses/cc-by", "maintainer": "8f9b58d8-7cf2-4761-a665-60edc2911db0", "metadata_created": "2019-03-19T12:02:06.426498", "metadata_modified": "2026-05-11T13:18:43.888493", "methodology": "Other", "methodology_other": "Twice a year in over 90 countries, the Meta Survey Team sends the Future of Business to admins and owners of Facebook-designated small business pages. When we share data from this survey, we anonymize responses to all survey questions and only share country-level data publicly. To achieve better representation of the broader small business population, we also weight our results based on known characteristics of the Facebook Page admin population.", "name": "future-of-business-survey-aggregated-data", "notes": "More than 200 million businesses use Facebook globally. The goal of our Small Business Surveys has been to learn about the unique perspectives, challenges and opportunities of small and medium-sized businesses (SMBs). Through 2022, the Future of Business Survey and the Global State of Small Business (GSoSB) Survey were conducted in partnership with the World Bank and Organisation for Economic Cooperation and Development.\r\n\r\n\r\nAggregated country level data for each survey wave is available to the public on HDX and controlled access microdata is available to Data for Good at Meta partners. Please visit https://ai.meta.com/ai-for-good/datasets/small-business-surveys/ to apply for access to microdata or contact aiforgood@meta.com for any questions.\r\n\r\nThis dataset regularly updated until 2023-03-24 and is no longer expecting additional data.\r\n", "num_resources": 36, "num_tags": 5, "organization": {"id": "74ad0574-923d-430b-8d52-ad80256c4461", "name": "meta", "title": "AI for Good at Meta", "type": "organization", "description": "**We are interested in hearing from people who have used these datasets to improve our products and better understand the impact of this data. [Please consider taking this two-minute survey](https://forms.gle/EQFAbkkPVj5JtkSu7).** AI for Good at Meta's program includes tools built from de-identified data on our platform, as well as tools that we develop using satellite imagery and other publicly available sources. When data is shared responsibly with the communities that need it, it can improve wellbeing and save lives.", "image_url": "", "created": "2019-03-13T12:16:06.566996", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "74ad0574-923d-430b-8d52-ad80256c4461", "package_creator": "nicolefulk", "pageviews_last_14_days": 50, "private": false, "qa_completed": false, "solr_additions": "{\"countries\": [\"Angola\", \"Argentina\", \"Australia\", \"Bangladesh\", \"Belgium\", \"Benin\", \"Burkina Faso\", \"Burundi\", \"Cabo Verde\", \"Cambodia\", \"Cameroon\", \"Canada\", \"Central African Republic\", \"Chad\", \"China\", \"China, Hong Kong Special Administrative Region\", \"Colombia\", \"Costa Rica\", \"C\\u00f4te d'Ivoire\", \"Czechia\", \"Democratic Republic of the Congo\", \"Denmark\", \"Djibouti\", \"Ecuador\", \"Egypt\", \"Equatorial Guinea\", \"Estonia\", \"Ethiopia\", \"France\", \"Gabon\", \"Gambia\", \"Germany\", \"Ghana\", \"Greece\", \"Guinea\", \"Guinea-Bissau\", \"Hungary\", \"India\", \"Indonesia\", \"Iraq\", \"Ireland\", \"Israel\", \"Italy\", \"Japan\", \"Kenya\", \"Lebanon\", \"Lesotho\", \"Liberia\", 