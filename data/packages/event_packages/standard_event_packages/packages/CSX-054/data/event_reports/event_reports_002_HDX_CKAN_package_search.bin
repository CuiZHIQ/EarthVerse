, \"nrows\": 5, \"ncols\": 140, \"has_merged_cells\": false, \"is_hxlated\": false, \"header_hash\": \"0ba1264aa5ca749341d8ea9d261fe71c\", \"hashtag_hash\": null}]}}]", "hash": "", "hdx_rel_url": "/dataset/2e49de77-72e6-46c3-b0b8-439ee21e6ad5/resource/5fd834bf-cb49-488d-820f-fa77f3cc5f55/download/2022-sdn-flood-disaster-monitoring-matrix-may-to-sep-2022-1.xlsx", "id": "5fd834bf-cb49-488d-820f-fa77f3cc5f55", "last_modified": "2023-04-03T11:26:43.987521", "metadata_modified": "2024-08-23T09:19:11.193231", "microdata": false, "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "mimetype_inner": null, "name": "2022-sdn-flood-disaster-monitoring-matrix-may-to-sep-2022.xlsx", "originalHash": 1754560028, "package_id": "2e49de77-72e6-46c3-b0b8-439ee21e6ad5", "pii": "false", "pii_predict_score": 0.8562966605953982, "pii_report_flag": "FINDINGS", "pii_report_id": "/resources/5fd834bf-cb49-488d-820f-fa77f3cc5f55/pii.2023-04-03T11-26-49.main.json", "pii_timestamp": "2023-04-03T11:27:07.728000", "position": 3, "resource_type": "file.upload", "size": 101481, "state": "active", "url": "https://data.humdata.org/dataset/2e49de77-72e6-46c3-b0b8-439ee21e6ad5/resource/5fd834bf-cb49-488d-820f-fa77f3cc5f55/download/2022-sdn-flood-disaster-monitoring-matrix-may-to-sep-2022-1.xlsx", "url_type": "upload"}, {"cache_last_updated": null, "cache_url": null, "created": "2025-12-08T07:53:21.094413", "dataset_preview_enabled": false, "datastore_active": false, "description": "Dataset on people affected by floods in Sudan in the year 2020.", "download_url": "https://data.humdata.org/dataset/sudan-people-affected-by-floods-as-of-6-october-2020", "format": "Web App", "hash": "", "hdx_rel_url": "https://data.humdata.org/dataset/sudan-people-affected-by-floods-as-of-6-october-2020", "id": "34a83783-c9d8-478a-ae96-be1131214df8", "last_modified": "2025-12-08T07:53:21.082433", "metadata_modified": "2025-12-08T07:53:21.983691", "microdata": false, "mimetype": null, "mimetype_inner": null, "name": "SDN_HAC_Flood data by state and locality_07102020", "originalHash": 8750915, "package_id": "2e49de77-72e6-46c3-b0b8-439ee21e6ad5", "pii": false, "position": 4, "resource_type": "api", "size": 0, "state": "active", "upload": null, "url": "https://data.humdata.org/dataset/sudan-people-affected-by-floods-as-of-6-october-2020", "url_type": "api"}], "tags": [{"display_name": "affected population", "id": "9f9d19d4-901f-4b57-b781-e6b2b56e2138", "name": "affected population", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "climate-weather", "id": "6f0a101d-5c57-408b-aa2a-61c078d32713", "name": "climate-weather", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "flooding", "id": "532eacf2-7b8c-4dd5-baf7-c25720cadb38", "name": "flooding", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "geodata", "id": "2d27d72f-af37-4b38-b05e-dddc6929bd13", "name": "geodata", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "hxl", "id": "a0fbb23a-6aad-4ccc-8062-e9ef9f20e5d2", "name": "hxl", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}], "relationships_as_subject": [], "relationships_as_object": []}, {"archived": true, "batch": "b78a4bd0-e913-47b0-805b-3cf372a683fd", "caveats": "This is a preliminary assessment and has not yet been validated in the field. It is important to consider the characteristics of the source imagery used in the analyses when interpreting results. For damage assessments it should be noted that only significant damage to the structural integrity of the buildings analyzed can be seen in imagery, while minor damage such as cracks or holes may not be visible at all. For flood extractions using radar data it is important to note that urban areas and highly vegetated areas may mask the flood signature and result in underestimation of flood waters. Users with specific questions or concerns should contact unosat@unitar.org to seek clarification.", "creator_user_id": "1a008a13-52b1-4326-a9ea-aa541372577c", "data_update_frequency": "-1", "dataset_date": "[2024-08-28T00:00:00 TO 2024-08-28T23:59:59]", "dataset_preview": "first_resource", "dataset_source": "UN Operational Satellite Applications Programme (UNOSAT)", "has_geodata": true, "has_showcases": true, "id": "66d89c1c-c2f2-48d5-bf53-06cc2619fa4b", "is_requestdata_type": false, "isopen": true, "last_modified": "2024-08-28T13:40:39", "license_id": "cc-by-sa", "license_title": "Creative Commons Attribution Share-Alike (CC BY-SA)", "license_url": "http://www.opendefinition.org/licenses/cc-by-sa", "maintainer": "83fa9515-3ba4-4f1d-9860-f38b20f80442", "metadata_created": "2024-08-29T08:35:50.540329", "metadata_modified": "2025-11-24T21:37:30.825897", "methodology": "Other", "methodology_other": "UNOSAT datasets and maps are produced using a variety of methods. In general, analysts closely review satellite imagery, often comparing two or more images together, and determine notable changes between the images. For damage assessments, refugee or IDP assessments, and similar analyses, these changes are then manually documented in the vector data by the analyst. For flood extractions, landcover mapping and similar analyses, a variety of automated remote sensing techniques are used to extract the relevant information which is then reviewed and revised as necessary by the analyst. In all cases, resulting data is then loaded into a standardized UNOSAT geodatabase and exported asshapefiles for dissemination.", "name": "unosat-live-webmap-floods-in-sudan-august-2024", "notes": "**UNOSAT code: FL20240826SDN, GDACS ID: 1102854**  This application provides geospatial information regarding the analysis related to the floods in Sudan in August 2024.  \nImportant note: The boundaries and names shown, and the designations used on this map do not imply official endorsement or acceptance by the United Nations. The United Nations Satellite Centre. UNOSAT is not responsible for the misuse or misrepresentation of the map.", "num_resources": 2, "num_tags": 2, "organization": {"id": "ba5aacba-0633-4364-9528-bc76a3f6cf95", "name": "unosat", "title": "United Nations Satellite Centre (UNOSAT)", "type": "organization", "description": "The United Nations Satellite Centre (UNOSAT) it is part of the United Nations Institute for Training and Research (UNITAR), with a mandate to provide United Nations funds, programmes and specialized agencies with satellite analysis, training and capacity development, at their request, as well as to support Member States with satellite imagery analysis over their respective territories and to provide training and capacity development in the use of geospatial information technologies.", "image_url": "", "created": "2015-01-09T15:34:40.199033", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "ba5aacba-0633-4364-9528-bc76a3f6cf95", "package_creator": "unosat", "pageviews_last_14_days": 0, "private": false, "qa_completed": false, "solr_additions": "{\"countries\": [\"Sudan\"]}", "state": "active", "subnational": "0", "title": "UNOSAT Live Webmap, Floods in Sudan - August 2024", "total_res_downloads": 25, "type": "dataset", "updated_by_script": "HDXINTERNAL:HDXPythonLibrary/6.1.3-ArchiveOldDatasets (2025-11-24T21:37:30.751044)", "url": null, "version": null, "groups": [{"description": "", "display_name": "Sudan", "id": "sdn", "image_display_url": "", "name": "sdn", "title": "Sudan"}], "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2024-08-29T08:35:50.542916", "datastore_active": false, "description": "Zipped geodatabase", "download_url": "https://unosat.org/static/unosat_filesystem/3931/FL20240826SDN_gdb.zip", "format": "Geodatabase", "hash": "\"66cf28d7-1e038b\"", "hdx_rel_url": "https://unosat.org/static/unosat_filesystem/3931/FL20240826SDN_gdb.zip", "id": 