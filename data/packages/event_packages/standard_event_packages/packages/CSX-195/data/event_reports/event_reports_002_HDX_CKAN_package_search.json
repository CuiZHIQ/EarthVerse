cog", "image_display_url": "", "name": "cog", "title": "Congo"}, {"description": "", "display_name": "Cook Islands", "id": "cok", "image_display_url": "", "name": "cok", "title": "Cook Islands"}, {"description": "", "display_name": "Costa Rica", "id": "cri", "image_display_url": "", "name": "cri", "title": "Costa Rica"}, {"description": "", "display_name": "C\u00f4te d'Ivoire", "id": "civ", "image_display_url": "", "name": "civ", "title": "C\u00f4te d'Ivoire"}, {"description": "", "display_name": "Croatia", "id": "hrv", "image_display_url": "", "name": "hrv", "title": "Croatia"}, {"description": "", "display_name": "Cura\u00e7ao", "id": "6b7c18d2-d3e2-4193-9ce8-3820557a04a3", "image_display_url": "", "name": "cuw", "title": "Cura\u00e7ao"}, {"description": "", "display_name": "Cyprus", "id": "cyp", "image_display_url": "", "name": "cyp", "title": "Cyprus"}, {"description": "", "display_name": "Czechia", "id": "cze", "image_display_url": "", "name": "cze", "title": "Czechia"}, {"description": "", "display_name": "Democratic People's Republic of Korea", "id": "prk", "image_display_url": "", "name": "prk", "title": "Democratic People's Republic of Korea"}, {"description": "", "display_name": "Democratic Republic of the Congo", "id": "cod", "image_display_url": "", "name": "cod", "title": "Democratic Republic of the Congo"}, {"description": "", "display_name": "Denmark", "id": "dnk", "image_display_url": "", "name": "dnk", "title": "Denmark"}, {"description": "", "display_name": "Djibouti", "id": "dji", "image_display_url": "", "name": "dji", "title": "Djibouti"}, {"description": "", "display_name": "Dominica", "id": "dma", "image_display_url": "", "name": "dma", "title": "Dominica"}, {"description": "", "display_name": "Dominican Republic", "id": "dom", "image_display_url": "", "name": "dom", "title": "Dominican Republic"}, {"description": "", "display_name": "Ecuador", "id": "ecu", "image_display_url": "", "name": "ecu", "title": "Ecuador"}, {"description": "", "displ