": "vaccination-immunization", "id": "61a7024e-7387-49ca-a9de-344bdceb3698", "name": "vaccination-immunization", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "women", "id": "fe10e36f-97a0-4383-ae31-29a8e8265669", "name": "women", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}], "relationships_as_subject": [], "relationships_as_object": []}, {"archived": false, "batch": "39551a66-2ede-455c-a20f-cfbc0725d5b3", "caveats": "The data must be requested via the resource download link", "creator_user_id": "1a008a13-52b1-4326-a9ea-aa541372577c", "data_update_frequency": "-1", "dataset_date": "[2022-01-01T00:00:00 TO 2022-12-31T23:59:59]", "dataset_preview": "first_resource", "dataset_source": "UNHCR", "has_geodata": false, "has_showcases": false, "id": "c9f06f75-1313-4a68-8569-82f9f56e6084", "is_requestdata_type": false, "isopen": false, "last_modified": "2023-12-21T00:00:00", "license_id": "hdx-other", "license_other": "Scientific Use License. See [terms of use](https://microdata.unhcr.org/index.php/terms-of-use) for details.", "license_title": "Other", "maintainer": "ac47b0c8-548b-4c37-a685-7377e75aad55", "metadata_created": "2024-01-14T01:29:07.313453", "metadata_modified": "2026-05-21T14:37:12.681568", "methodology": "Other", "methodology_other": "Kind of Data: Sample survey data [ssd]  \nUnit of Analysis: Asylum-seekers and other border crossers in 2022  \nSampling Procedure: Not Applicable  \nData Collection Mode: Face-to-face [f2f]  \n", "name": "unhcr-afg-2022-bmo-anon-data-v2-1", "notes": "The situation inside Afghanistan deteriorated in 2021 and had significant consequences for the most vulnerable among the population. Iran and Pakistan, which are neighbours of Afghanistan, also host some 8.2 million registered Afghan refugees and other Afghans with different statuses. The majority of registered refugees fled Afghanistan over the years, including from as early as 1979.\n  \n  UNHCR border monitoring seeks to understand the triggers, intentions and reasons for Afghan cross-border movements, assess access to territory and \u201cthe right to seek asylum\u201d as well as the barriers which hinder the movement of people who may need international protection. In 2022, more than 78,000 interviews were conducted with people across six crossing points into Pakistan, Iran and Central Asia from Afghanistan.\n\n  This dataset is the anonymized version of the original data.", "num_resources": 2, "num_tags": 6, "organization": {"id": "abf4ca86-8e69-40b1-92f7-71509992be88", "name": "unhcr", "title": "UNHCR - The UN Refugee Agency", "type": "organization", "description": "The Office of the United Nations High Commissioner for Refugees was established on December 14, 1950 by the United Nations General Assembly. The agency is mandated to lead and co-ordinate international action to protect refugees and resolve refugee problems worldwide. Its primary purpose is to safeguard the rights and well-being of refugees. It strives to ensure that everyone can exercise the right to seek asylum and find safe refuge in another State, with the option to return home voluntarily, integrate locally or to resettle in a third country. It also has a mandate to help stateless people.", "image_url": "", "created": "2014-05-21T12:08:06.445758", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "abf4ca86-8e69-40b1-92f7-71509992be88", "package_creator": "hdx_bot_scrapers", "pageviews_last_14_days": 0, "private": false, "qa_completed": false, "solr_additions": "{\"countries\": [\"Afghanistan\"]}", "state": "active", "subnational": "1", "title": "Afghanistan - Border Monitoring, outflow - 2022", "total_res_downloads": 5, "type": "dataset", "updated_by_script": "HDX Scraper: UNHCR microdata (2026-05-21T14:37:12.554151)", "url": null, "version": null, "groups": [{"description": "", "display_name": "Afghanistan", "id": "afg", "image_display_url": "", "name": "afg", "title": "Afghanistan"}], "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2024-01-14T01:29:07.316317", "datastore_active": false, "description": "Clicking \"Download\" leads outside HDX where you can request access to the data in csv, xlsx & dta formats", "download_url": "https://microdata.unhcr.org/index.php/auth/login/?destination=catalog/1047/get-microdata", "format": "Web App", "hash": "", "hdx_rel_url": "https://microdata.unhcr.org/index.php/auth/login/?destination=catalog/1047/get-microdata", "id": "8287f207-5e9c-4587-bc28-309cc0649520", "last_modified": "2023-12-21T00:00:00", "metadata_modified": "2024-01-21T01:29:45.897024", "microdata": false, "mimetype": null, "mimetype_inner": null, "name": "Afghanistan - Border Monitoring, outflow - 2022", "package_id": "c9f06f75-1313-4a68-8569-82f9f56e6084", "position": 0, "resource_type": "api", "size": null, "state": "active", "url": "https://microdata.unhcr.org/index.php/auth/login/?destination=catalog/1047/get-microdata", "url_type": "api"}, {"broken_link": true, "cache_last_updated": null, "cache_url": null, "created": "2024-01-14T01:29:07.316321", "datastore_active": false, "description": "Contains information about the dataset's metadata and data", "download_url": "https://microdata.unhcr.org/index.php/catalog/1047/pdf-documentation", "format": "PDF", "hash": "e195921b563ca418317565e5f71fd4bf", "hdx_rel_url": "https://microdata.unhcr.org/index.php/catalog/1047/pdf-documentation", "id": "3294790e-5bff-4bbe-8374-bb11e572e83e", "last_modified": "2023-12-21T00:00:00", "metadata_modified": "2025-09-28T10:20:38.513799", "microdata": false, "mimetype": null, "mimetype_inner": null, "name": "Codebook", "package_id": "c9f06f75-1313-4a68-8569-82f9f56e6084", "position": 1, "resource_type": "api", "size": 38451, "state": "active", "url": "https://microdata.unhcr.org/index.php/catalog/1047/pdf-documentation", "url_type": "api"}], "tags": [{"display_name": "education", "id": "111f9068-6270-4db