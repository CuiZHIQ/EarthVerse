<a href="/media/project-update/advancing-climate-services-health-new-milestones-from-who-wmo-accelerator" class="group h-full inline-block w-full">
  <article class="h-full flex flex-col rounded-lg shadow-md overflow-hidden inline-block">

                  <figure class="child-object-cover w-full">
