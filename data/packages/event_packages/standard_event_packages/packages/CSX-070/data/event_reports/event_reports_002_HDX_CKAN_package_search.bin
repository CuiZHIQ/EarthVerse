"2025-03-10T23:35:44.929359", "microdata": false, "mimetype": "application/pdf", "mimetype_inner": null, "name": "INFORM Report 2024.pdf", "originalHash": "-988266717", "package_id": "2048a947-5714-4220-905b-e662cbcd14c8", "pii": "false", "position": 37, "resource_type": "file.upload", "size": 12775860, "state": "active", "url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/86c9b04d-b09c-4b90-9333-ed02f0fe44c7/download/inform-report-2024.pdf", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/97e7f593-82c5-490d-a24c-2d4e5b02f35b/download/", "cache_last_updated": null, "cache_url": null, "created": "2024-02-28T17:59:20.616386", "datastore_active": false, "description": "The State of Open Humanitarian Data 2024 contains details on the data available for each location, category and sub-category covered in the HDX Data Grids. It includes a country deep-dive for Colombia and showcases HDX's longstanding partnership with the World Food Programme (WFP). It also provides an example of how climate data is being used to predict the impact of typhoons in the Philippines and trigger anticipatory action.", "download_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/97e7f593-82c5-490d-a24c-2d4e5b02f35b/download/the-state-of-open-humanitarian-data-2024.pdf", "format": "PDF", "hash": "\"1709145806.628-14421269-3401652246\"", "hdx_rel_url": "/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/97e7f593-82c5-490d-a24c-2d4e5b02f35b/download/the-state-of-open-humanitarian-data-2024.pdf", "id": "97e7f593-82c5-490d-a24c-2d4e5b02f35b", "last_modified": "2024-02-28T18:43:26", "metadata_modified": "2025-03-10T23:35:44.929504", "microdata": false, "mimetype": "application/pdf", "mimetype_inner": null, "name": "The State of Open Humanitarian Data 2024.pdf", "originalHash": "2024797938", "package_id": "2048a947-5714-4220-905b-e662cbcd14c8", "pii": "false", "position": 38, "resource_type": "file.upload", "size": 14421269, "state": "active", "url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/97e7f593-82c5-490d-a24c-2d4e5b02f35b/download/the-state-of-open-humanitarian-data-2024.pdf", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/956f7bcd-fd2f-4256-a12c-cba81ae2c7ba/download/", "cache_last_updated": null, "cache_url": null, "created": "2024-02-16T18:32:16.775350", "datastore_active": false, "description": "This technical note summarises the methodology used to calculate the number of people\r\npotentially exposed to flooding in Somalia in the 2024 Somalia Humanitarian Needs and\r\nResponse Plan (HNRP).", "download_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/956f7bcd-fd2f-4256-a12c-cba81ae2c7ba/download/chd_som_2024_technical_note_flood_risk_hnrp.pdf", "format": "PDF", "hash": "\"1708108381.223-57173-3056867261\"", "hdx_rel_url": "/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/956f7bcd-fd2f-4256-a12c-cba81ae2c7ba/download/chd_som_2024_technical_note_flood_risk_hnrp.pdf", "id": "956f7bcd-fd2f-4256-a12c-cba81ae2c7ba", "last_modified": "2024-02-16T18:33:01", "metadata_modified": "2025-03-10T23:35:44.929632", "microdata": false, "mimetype": "application/pdf", "mimetype_inner": null, "name": "CHD_SOM_2024_Technical_Note_Flood_Risk_HNRP.pdf", "originalHash": "-988266717", "package_id": "2048a947-5714-4220-905b-e662cbcd14c8", "pii": "false", "position": 39, "resource_type": "file.upload", "size": 57173, "state": "active", "url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/956f7bcd-fd2f-4256-a12c-cba81ae2c7ba/download/chd_som_2024_technical_note_flood_risk_hnrp.pdf", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/6c51a523-23d8-4207-be80-03dc0ad658c1/download/", "cache_last_updat