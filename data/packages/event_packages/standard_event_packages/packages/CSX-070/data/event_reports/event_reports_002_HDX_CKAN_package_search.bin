8:34.386166\", \"sheet_changes\": [], \"hxl_proxy_response\": {\"url_or_filename\": \"https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/107da350-6d50-48cd-b001-d5dcdfaafee7/download/google_open_buildings.csv\", \"format\": \"CSV\", \"sheets\": [{\"name\": \"__DEFAULT__\", \"nrows\": 880, \"ncols\": 12, \"is_hidden\": false, \"has_merged_cells\": false, \"is_hxlated\": false, \"header_hash\": \"dd9f24db4659bd0cc3ce09ea5c4c7595\", \"hxl_header_hash\": null, \"headers\": [\"uuid\", \"adm4_pcode\", \"date\", \"freq\", \"google_bldgs_count\", \"google_bldgs_area_total\", \"google_bldgs_area_mean\", \"google_bldgs_count_lt100_sqm\", \"google_bldgs_count_100_200_sqm\", \"google_bldgs_count_gt_200_sqm\", \"google_bldgs_density\", \"google_bldgs_pct_built_up_area\"], \"hxl_headers\": null}]}}]", "hash": "", "hdx_rel_url": "/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/107da350-6d50-48cd-b001-d5dcdfaafee7/download/google_open_buildings.csv", "id": "107da350-6d50-48cd-b001-d5dcdfaafee7", "last_modified": "2024-05-01T15:18:30.482932", "metadata_modified": "2025-04-15T16:19:49.088908", "microdata": false, "mimetype": "text/csv", "mimetype_inner": null, "name": "google_open_buildings.csv", "originalHash": 843335300, "p_coded": false, "package_id": "5b580664-365e-4d7e-b5e5-2990df8f12a5", "pii": "false", "position": 18, "resource_type": "file.upload", "size": 112257, "state": "active", "url": "https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/107da350-6d50-48cd-b001-d5dcdfaafee7/download/google_open_buildings.csv", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/d8b70ecf-d796-4d0e-a028-04c83904e905/download/", "cache_last_updated": null, "cache_url": null, "created": "2024-05-01T15:20:08.304141", "dataset_preview_enabled": false, "datastore_active": false, "description": "Percent accessible barangay population within a 5-30 minutes travel time from n