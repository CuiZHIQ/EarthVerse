, \"nrows\": 6154, \"ncols\": 9, \"is_hidden\": false, \"has_merged_cells\": false, \"is_hxlated\": false, \"header_hash\": \"7957ca5abbea4edcf9d4d09b67d1841b\", \"hxl_header_hash\": null, \"headers\": [\"uuid\", \"adm4_pcode\", \"date\", \"freq\", \"rwi_max\", \"rwi_mean\", \"rwi_median\", \"rwi_min\", \"rwi_std\"], \"hxl_headers\": null}]}}]", "hash": "", "hdx_rel_url": "/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/21b81755-4aa3-4b11-b57b-b55cf63b978c/download/tm_relative_wealth_index.csv", "id": "21b81755-4aa3-4b11-b57b-b55cf63b978c", "last_modified": "2024-05-01T15:38:07.409479", "metadata_modified": "2025-04-15T16:20:03.912742", "microdata": false, "mimetype": "text/csv", "mimetype_inner": null, "name": "tm_relative_wealth_index.csv", "originalHash": "-988266717", "p_coded": false, "package_id": "5b580664-365e-4d7e-b5e5-2990df8f12a5", "pii": "false", "position": 24, "resource_type": "file.upload", "size": 800364, "state": "active", "url": "https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/21b81755-4aa3-4b11-b57b-b55cf63b978c/download/tm_relative_wealth_index.csv", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/eeef7c8c-939e-4ec9-877b-2c06962c5a27/download/", "cache_last_updated": null, "cache_url": null, "created": "2024-05-01T15:36:17.162639", "dataset_preview_enabled": false, "datastore_active": false, "description": "Building outlines and annotations from a sampling of 250x250m tiles within chosen cities. These tiles were carefully selected to focus on residential areas with diverse neighborhood densities, terrains, and levels of urbanization, as well as areas not yet mapped in OpenStreetMap. Each outline was drawn using a combination of visual inspection of satellite imagery, local knowledge, and validation from household survey data to cover all buildings present in the tile. \r\n\r\nThe attributes contain variables designed to indicate potential wealth markers useful for vulnerability analysis, and can also be used in computer vision models to expand the spatial coverage of the dataset. \r\n\r\nThis table is also released as its own, standalone dataset, TM Open Buildings, which can be viewed [here](https://wiki.openstreetmap.org/wiki/TM_Open_Buildings). It is also hosted separately for download in [Kaggle](https://www.kaggle.com/datasets/thinkdatasci/tm-open-buildings-philippines) and [HDX](https://data.humdata.org/dataset/tm-open-buildings-philippines). \r\n", "download_url": "https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/eeef7c8c-939e-4ec9-877b-2c06962c5a27/download/tm_open_buildings.csv", "format": "CSV", "fs_check_info": "[{\"state\": \"processing\", \"message\": \"The processing of the file structure check has started\", \"timestamp\": \"2024-05-01T15:36:16.424819\"}, {\"state\": \"success\", \"message\": \"File structure check completed\", \"timestamp\": \"2024-05-01T15:36:20.050849\", \"sheet_changes\": [], \"hxl_proxy_response\": {\"url_or_filename\": \"https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/eeef7c8c-939e-4ec9-877b-2c06962c5a27/download/tm_open_buildings.csv\", \"format\": \"CSV\", \"sheets\": [{\"name\": \"__DEFAULT__\", \"nrows\": 12370, \"ncols\": 12, \"is_hidden\": false, \"has_merged_cells\": false, \"is_hxlated\": false, \"header_hash\": \"2a05be55763fff69b920a4e1afe953db\", \"hxl_header_hash\": null, \"headers\": [\"adm3_pcode\", \"adm4_pcode\", \"tile_id\", \"osm_id\", \"settlement_type\", \"roof_material\", \"roof_layout\", \"roof_area\", \"is_gated\", \"density\", \"height\", \"geometry\"], \"hxl_headers\": null}]}}]", "hash": "", "hdx_rel_url": "/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/eeef7c8c-939e-4ec9-877b-2c06962c5a27/download/tm_open_buildings.csv", "id": "eeef7c8c-939e-4ec9-877b-2c06962c5a27", "last_modified": "2024-05-01T15:36:16.707712", "metadata_modified": "2025-04-15T16:20:05.060420", "microdata"