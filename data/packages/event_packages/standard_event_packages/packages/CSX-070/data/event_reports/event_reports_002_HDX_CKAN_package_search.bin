0ffed95f6/resource/7b7331a2-304a-42ff-ac46-8e72e7434c1d/download/afghanistan-natural-disaster-incidents-from-january-to-may-2026.xlsx", "id": "7b7331a2-304a-42ff-ac46-8e72e7434c1d", "last_modified": "2026-05-17T06:55:24.249371", "metadata_modified": "2026-05-17T06:55:53.186453", "microdata": false, "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "mimetype_inner": null, "name": "afghanistan-natural-disaster-incidents-from-january-to-may-2026.xlsx", "originalHash": "-1902617512", "p_coded": true, "package_id": "0eb7c089-7b18-442a-afeb-6380ffed95f6", "pii": "false", "position": 0, "resource_type": "file.upload", "sdd_report": "[\n  {\n    \"resource_id\": \"7b7331a2-304a-42ff-ac46-8e72e7434c1d\",\n    \"file_name\": \"https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/7b7331a2-304a-42ff-ac46-8e72e7434c1d/download/afghanistan-natural-disaster-incidents-from-january-to-may-2026.xlsx\",\n    \"file_url\": \"https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/7b7331a2-304a-42ff-ac46-8e72e7434c1d/download/afghanistan-natural-disaster-incidents-from-january-to-may-2026.xlsx\",\n    \"sheet_name\": \"NOTES\",\n    \"processing_timestamp\": \"2026-05-17 06:55:35\",\n    \"processing_success\": true,\n    \"n_records\": 5,\n    \"n_columns\": 1,\n    \"completion_tokens\": 206,\n    \"prompt_tokens\": 1214,\n    \"personal_data_sensitive\": false,\n    \"non_personal_data_sensitive\": false,\n    \"personal_data\": {\n      \"sensitivity\": \"NON_SENSITIVE\",\n      \"explanation\": \"No PII columns detected in the dataset.\"\n    },\n    \"columns\": [\n      {\n        \"column_name\": \"Notes:\",\n        \"sample_values\": [\n          \"Natural disaster incidents as recorded by OCHA Field Offices and partners  from 01 January to 1 May 2026.\",\n          \"Natural disaster types include, Avalanche, Earthquake, Flash Flood, Flood, Heavy Rainfall/Snowfall, Landslide and Mudflow. Drought, fires, river bank erosion and other disasters have been removed from the dataset.\",\n          \"All incident records have been aggreagated to a unique event (natural disaster type and date) by district.\",\n          \"A natural disaster incident is defined as an event that has affected (i.e. impacted) Afghans, who may or may not require humanitarian assistance.\",\n          \"OCHA information includes assessment figures from OCHA, ANDMA, IOM, Red Crescent Societies, national NGOs, international NGOs.\"\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      }\n    ],\n    \"non_personal_data\": {\n      \"sensitivity\": \"NON_SENSITIVE\",\n      \"sensitive_columns\": [],\n      \"cited_isp_rules\": [\n        \"- Survey or needs assessment data aggregated to the district level\"\n      ],\n      \"explanation\": \"The table contains natural disaster incident data aggregated to the district level by event type and date. This directly aligns with the ISP rule for MODERATE_SENSITIVE data. However, the ISP explicitly states that 3W/4W data at the district level is NON_SENSITIVE, with a noted exception for certain clusters. This dataset, which details the 'Who, What, Where, and When' of humanitarian events, is a classic example of 3W/4W data. As no Data Impact Assessment is mentioned that would override this, the highest applicable classification is NON_SENSITIVE. No individual columns are sensitive on their own or in combination, as the data is aggregated and does not contain personal, beneficiary, or community-level information.\",\n      \"isp_name\": \"AFG\"\n    },\n    \"pii_classifier_model\": \"DeepSeek-V3.1\",\n    \"pii_reflection_model\": \"skipped - no PII columns\",\n    \"non_pii_model\": \"DeepSeek-V3.1\"\n  },\n  {\n    \"resource_id\": \"7b7331a2-304a-42ff-ac46-8e72e7434c1d\",\n    \"file_name\": \"https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/7b7331a2-304a-42ff-ac46-8e72e7434c1d/download/afghanistan-natural-disaster-incidents-from-january-to-may-2026.xlsx\",\n    \"file_url\": \"https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/7b7331a2-304a-42ff-ac46-8e72e7434c1d/download/afghanistan-natural-disaster-incidents-from-january-to-may-2026.xlsx\",\n    \"sheet_name\": \"Data\",\n    \"processing_timestamp\": \"2026-05-17 06:55:40\",\n    \"processing_success\": true,\n    \"n_records\": 209,\n    \"n_columns\": 13,\n    \"completion_tokens\": 233,\n    \"prompt_tokens\": 3883,\n    \"personal_data_sensitive\": false,\n    \"non_personal_data_sensitive\": false,\n    \"personal_data\": {\n      \"sensitivity\": \"NON_SENSITIVE\",\n      \"explanation\": \"No PII columns detected in the dataset.\"\n    },\n    \"columns\": [\n      {\n        \"column_name\": \"REGION\",\n        \"sample_values\": [\n          \"#adm1 +name +en\",\n          \"Capital\",\n          \"Capital\",\n          \"Capital\",\n          \"Capital\"\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      },\n      {\n        \"column_name\": \"PROV_CODE\",\n        \"sample_values\": [\n          \"#adm2 +code\",\n          \"AF03\",\n          \"AF03\",\n          \"AF03\",\n          \"AF02\"\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      },\n      {\n        \"column_name\": \"PROV_NAME\",\n        \"sample_values\": [\n          \"#adm2 +name +en\",\n          \"Parwan\",\n          \"Parwan\",\n          \"Parwan\",\n          \"Kapisa\"\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      },\n      {\n        \"column_name\": \"DIST_CODE\",\n        \"sample_values\": [\n          \"#adm3 +code\",\n          \"AF0303\",\n          \"AF0301\",\n          \"AF0303\",\n          \"AF0204\"\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      },\n      {\n        \"column_name\": \"DIST_NAME\",\n        \"sample_values\": [\n          \"#adm3 +name +en\",\n          \"Shinwari\",\n          \"Charikar\",\n          \"Shinwari\",\n          \"Hisa-e-Awal-e-Kohistan\"\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      },\n      {\n        \"column_name\": \"INC_DATE\",\n        \"sample_values\": [\n          \"#cause +date\",\n          \"2026-01-22T00:00:00\",\n          \"2026-01-22T00:00:00\",\n          \"2026-03-23T00:00:00\",\n          \"2026-03-29T00:00:00\"\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      },\n      {\n        \"column_name\": \"INC_TYPE\",\n        \"sample_values\": [\n          \"#cause +type\",\n          \"Heavy snowfall\",\n          \"Heavy snowfall\",\n          \"Flood / flash flood\",\n          \"Flood / flash flood\"\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      },\n      {\n        \"column_name\": \"Persons_killed\",\n        \"sample_values\": [\n          \"#affected +killed +num\",\n          0,\n          0,\n          0,\n          0\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      },\n      {\n        \"column_name\": \"Persons_injured\",\n        \"sample_values\": [\n          \"#affected +injured +num\",\n          0,\n          0,\n          0,\n          0\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      },\n      {\n        \"column_name\": \"Families_affected\",\n        \"sample_values\": [\n          \"#affected +families +num\",\n          15,\n          5,\n          1,\n          36\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      },\n      {\n        \"column_name\": \"Individuals_affected\",\n        \"sample_values\": [\n          \"#affected +individuals +num\",\n          105,\n          35,\n          7,\n          252\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      },\n      {\n        \"column_name\": \"Houses_damaged\",\n        \"sample_values\": [\n          \"#damaged+houses+num\",\n          8,\n          3,\n          1,\n          11\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      },\n      {\n        \"column_name\": \"Houses_destroyed\",\n        \"sample_values\": [\n          \"#destroyed+houses+num\",\n          2,\n          0,\n          0,\n          0\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      }\n    ],\n    \"non_personal_data\": {\n      \"sensitivity\": \"NON_SENSITIVE\",\n      \"sensitive_columns\": [],\n      \"cited_isp_rules\": [\n        \"- Survey or needs assessment data aggregated to the district level\",\n        \"- District-level dashboard and underlying aggregated data from complaints and feedback mechanisms (excluding data related to SEA)\"\n      ],\n      \"explanation\": \"The table contains incident data aggregated at the district level (DIST_NAME), showing counts of affected individuals, families, and property damage. This aligns with the ISP's MODERATE_SENSITIVE category for district-level aggregated data. However, since the ISP explicitly lists '3W/4W data at district level' as NON_SENSITIVE (with a specific exception that doesn't apply here), and this humanitarian incident data is functionally similar to 3W/4W data in showing who/what/where/when of operations, the higher NON_SENSITIVE classification for district-level operational data takes precedence. No personally identifiable information or individual-level data is present.\",\n      \"isp_name\": \"AFG\"\n    },\n    \"pii_classifier_model\": \"DeepSeek-V3.1\",\n    \"pii_reflection_model\": \"skipped - no PII columns\",\n    \"non_pii_model\": \"DeepSeek-V3.1\"\n  },\n  {\n    \"resource_id\": \"7b7331a2-304a-42ff-ac46-8e72e7434c1d\",\n    \"file_name\": \"https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/7b7331a2-304a-42ff-ac46-8e72e7434c1d/download/afghanistan-natural-disaster-incidents-from-january-to-may-2026.xlsx\",\n    \"file_url\": \"https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/7b7331a2-304a-42ff-ac46-8e72e7434c1d/download/afghanistan-natural-disaster-incidents-from-january-to-may-2026.xlsx\",\n    \"sheet_name\": \"Sheet1\",\n    \"processing_timestamp\": \"2026-05-17 06:55:49\",\n    \"processing_success\": true,\n    \"n_records\": 6,\n    \"n_columns\": 1,\n    \"completion_tokens\": 202,\n    \"prompt_tokens\": 941,\n    \"personal_data_sensitive\": false,\n    \"non_personal_data_sensitive\": false,\n    \"personal_data\": {\n      \"sensitivity\": \"NON_SENSITIVE\",\n      \"explanation\": \"No PII columns detected in the dataset.\"\n    },\n    \"columns\": [\n      {\n        \"column_name\": \"INC_TYPE\",\n        \"sample_values\": [\n          \"Avalanche\",\n          \"Earthquake\",\n          \"Flood\",\n          \"Heavy Snowfall\",\n          \"Landslide and Mudflow\"\n        ],\n        \"personal_data\": {\n          \"entity_type\": \"None\",\n          \"sensitive\": false\n        }\n      }\n    ],\n    \"non_personal_data\": {\n      \"sensitivity\": \"NON_SENSITIVE\",\n      \"sensitive_columns\": [],\n      \"cited_isp_rules\": [\n        \"The table contains a single column listing incident types (e.g., Avalanche, Earthquake). This data does not match any of the categories defined as SEVERE_SENSITIVE, HIGH_SENSITIVE, or MODERATE_SENSITIVE. It is a simple list of event types with no personal, beneficiary, community, district, or national-level data, and is therefore classified as NON_SENSITIVE.\"\n      ],\n      \"explanation\": \"The 'INC_TYPE' column contains only general categories of natural disasters and incidents. It does not contain any personal data, beneficiary information, assessment data (raw or aggregated), feedback mechanism data, or any other data type specified in the ISP rules for sensitive classifications. As it is a non-specific reference list, it falls outside all defined sensitive categories and is considered NON_SENSITIVE.\",\n      \"isp_name\": \"AFG\"\n    },\n    \"pii_classifier_model\": \"DeepSeek-V3.1\",\n    \"pii_reflection_model\": \"skipped - no PII columns\",\n    \"non_pii_model\": \"DeepSeek-V3.1\"\n  }\n]", "sensitive": "not-sensitive", "size": 36220, "state": "active", "url": "https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/7b7331a2-304a-42ff-ac46-8e72e7434c1d/download/afghanistan-natural-disaster-incidents-from-january-to-may-2026.xlsx", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/400c82d6-cfdc-4e00-bd22-26fce7b7a3fc/download/", "cache_last_updated": null, "cache_url": null, "created": "2026-04-09T11:51:45.306961", "dataset_preview_enabled": false, "datastore_active": false, "description": "", "download_url": "https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/400c82d6-cfdc-4e00-bd22-26fce7b7a3fc/download/afghanistan-natural-disaster-incidents-from-january-to-may-2026.csv", "format": "CSV", "fs_check_info": "[{\"state\": \"processing\", \"message\": \"The processing of the file structure check has started\", \"timestamp\": \"2026-04-09T11:51:45.054136\"}, {\"state\": \"success\", \"message\": \"File