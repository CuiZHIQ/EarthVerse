932", "microdata": false, "mimetype": "application/pdf", "mimetype_inner": null, "name": "Model Report BFA AA.pdf", "originalHash": -948023298, "package_id": "2048a947-5714-4220-905b-e662cbcd14c8", "pii": "false", "position": 57, "resource_type": "file.upload", "size": 229304, "state": "active", "url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/3808ed54-307e-41b4-8819-71221d833c0a/download/model-report-bfa-aa.pdf", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/9d4121c6-b32b-4eb8-a707-209c79241970/download/", "cache_last_updated": null, "cache_url": null, "created": "2023-02-09T08:32:34.262109", "dataset_preview_enabled": false, "datastore_active": false, "description": "The State of Open Humanitarian Data 2023 contains details on the data available for each location, category and sub-category covered in 25 Data Grids. It includes a country deep-dive for South Sudan and showcases the work of the Humanitarian OpenStreetMap Team (HOT) on community mapping. It also provides examples of how climate impact data is being used to predict the impacts of a hazard on lives and livelihoods and trigger actions to mitigate them.", "download_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/9d4121c6-b32b-4eb8-a707-209c79241970/download/state-of-open-humanitarian-data-2023.pdf", "format": "PDF", "hash": "\"1686745587.015-3148720-3547469925\"", "hdx_rel_url": "/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/9d4121c6-b32b-4eb8-a707-209c79241970/download/state-of-open-humanitarian-data-2023.pdf", "id": "9d4121c6-b32b-4eb8-a707-209c79241970", "last_modified": "2025-03-18T13:13:13.825741", "metadata_modified": "2025-03-18T19:20:00.197506", "microdata": false, "mimetype": "application/pdf", "mimetype_inner": null, "name": "State of Open Humanitarian Data 2023.pdf", "originalHash": "1781637589", "package_id": "2048a947-5714-4220-905b-e662cbcd