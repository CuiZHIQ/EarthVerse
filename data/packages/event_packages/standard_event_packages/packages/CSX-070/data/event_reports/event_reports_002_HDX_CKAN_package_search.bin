ame\": \"https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/737c13eb-2266-40b0-b532-1982cef50efe/download/esa_worldcover.csv\", \"format\": \"CSV\", \"sheets\": [{\"name\": \"__DEFAULT__\", \"nrows\": 880, \"ncols\": 13, \"is_hidden\": false, \"has_merged_cells\": false, \"is_hxlated\": false, \"header_hash\": \"b86f23698170d6a49feaf3be70c93e92\", \"hxl_header_hash\": null, \"headers\": [\"uuid\", \"adm4_pcode\", \"date\", \"freq\", \"pct_area_bare_sparse_vegetation\", \"pct_area_builtup\", \"pct_area_cropland\", \"pct_area_grassland\", \"pct_area_herbaceous_wetland\", \"pct_area_mangroves\", \"pct_area_permanent_water_bodies\", \"pct_area_shrubland\", \"pct_area_tree_cover\"], \"hxl_headers\": null}]}}]", "hash": "", "hdx_rel_url": "/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/737c13eb-2266-40b0-b532-1982cef50efe/download/esa_worldcover.csv", "id": "737c13eb-2266-40b0-b532-1982cef50efe", "last_modified": "2024-05-01T15:15:26.815919", "metadata_modified": "2025-04-15T16:19:44.239315", "microdata": false, "mimetype": "text/csv", "mimetype_inner": null, "name": "esa_worldcover.csv", "originalHash": -1067119308, "p_coded": false, "package_id": "5b580664-365e-4d7e-b5e5-2990df8f12a5", "pii": "false", "position": 16, "resource_type": "file.upload", "size": 70190, "state": "active", "url": "https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/737c13eb-2266-40b0-b532-1982cef50efe/download/esa_worldcover.csv", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/b767e99d-8044-4ebb-a68a-0803a8a15c2b/download/", "cache_last_updated": null, "cache_url": null, "created": "2024-05-01T15:34:29.951059", "dataset_preview_enabled": false, "datastore_active": false, "description": "Hazard level area percentages for flooding and landslides from [Project NOAH](https://noah.up.edu.ph/). For the flood level definitions, it is as follows: low flood hazard level is a knee-level flood, a medium flood hazard level is knee to neck level, and a high flood hazard level is described as flood that is above the neck. Further information on the data source can be found in the download link from their home page.\n\nMore details on the processing of the hazard level area percentages can be found in the [github repository](https://github.com/thinkingmachines/project-cchain/tree/main/notebooks/02_dataset_alignment/noah).\n", "download_url": "https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/b767e99d-8044-4ebb-a68a-0803a8a15c2b/download/project_noah_hazards.csv", "format": "CSV", "fs_check_info": "[{\"state\": \"processing\", \"message\": \"The processing of the file structure check has started\", \"timestamp\": \"2024-05-01T15:34:29.293974\"}, {\"state\": \"success\", \"message\": \"File structure check completed\", \"timestamp\": \"2024-05-01T15:34:32.293361\", \"sheet_changes\": [], \"hxl_proxy_response\": {\"url_or_filename\": \"https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/b767e99d-8044-4ebb-a68a-0803a8a15c2b/download/project_noah_hazards.csv\", \"format\": \"CSV\", \"sheets\": [{\"name\": \"__DEFAULT__\", \"nrows\": 880, \"ncols\": 16, \"is_hidden\": false, \"has_merged_cells\": false, \"is_hxlated\": false, \"header_hash\": \"947413046862e25201b02cd45f5b4f43\", \"hxl_header_hash\": null, \"headers\": [\"uuid\", \"adm4_pcode\", \"date\", \"freq\", \"pct_area_flood_hazard_100yr_low\", \"pct_area_flood_hazard_100yr_med\", \"pct_area_flood_hazard_100yr_high\", \"pct_area_flood_hazard_25yr_low\", \"pct_area_flood_hazard_25yr_med\", \"pct_area_flood_hazard_25yr_high\", \"pct_area_flood_hazard_5yr_low\", \"pct_area_flood_hazard_5yr_med\", \"pct_area_flood_hazard_5yr_high\", \"pct_area_landslide_hazard_low\", \"pct_area_landslide_hazard_med\", \"pct_area_landslide_hazard_high\"], \"hxl_headers\": null}]}}]", "hash": "", "hdx_rel_url": "/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/