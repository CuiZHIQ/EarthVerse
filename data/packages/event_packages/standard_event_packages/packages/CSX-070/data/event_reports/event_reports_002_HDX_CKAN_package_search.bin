download/afghanistan-natural-disaster-incidents-from-january-to-november-2023.xlsx", "id": "a41a718c-79ee-40da-968d-fa06e2919f67", "last_modified": "2025-03-26T06:08:20.643983", "metadata_modified": "2025-06-03T07:20:24.667634", "microdata": false, "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "mimetype_inner": null, "name": "afghanistan-natural-disaster-incidents-from-january-to-november-2023.xlsx", "originalHash": "8750915", "package_id": "0eb7c089-7b18-442a-afeb-6380ffed95f6", "pii": "false", "position": 6, "resource_type": "file.upload", "size": 60780, "state": "active", "url": "https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/a41a718c-79ee-40da-968d-fa06e2919f67/download/afghanistan-natural-disaster-incidents-from-january-to-november-2023.xlsx", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/3cd7b03d-6298-4796-a2a7-ab3aceff32d1/download/", "cache_last_updated": null, "cache_url": null, "created": "2025-03-26T06:08:22.541285", "dataset_preview_enabled": false, "datastore_active": false, "description": "", "download_url": "https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/3cd7b03d-6298-4796-a2a7-ab3aceff32d1/download/afghanistan-natural-disaster-incidents-from-january-to-november-2023.csv", "format": "CSV", "fs_check_info": "[{\"state\": \"processing\", \"message\": \"The processing of the file structure check has started\", \"timestamp\": \"2025-03-26T06:08:22.120274\"}, {\"state\": \"success\", \"message\": \"File structure check completed\", \"timestamp\": \"2025-03-26T06:08:24.398527\", \"sheet_changes\": [], \"hxl_proxy_response\": {\"url_or_filename\": \"https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/3cd7b03d-6298-4796-a2a7-ab3aceff32d1/download/afghanistan-natural-disaster-incidents-from-january-to-november-2023.csv\", \"format\": \"CSV\", \"sheets\": [{\"name\": \"__DEFAULT__\", \"nrows\": 681, \"ncols\": 13, \"is_hidden\": false, \"has_merged_cells\": false, \"is_hxlated\": true, \"header_hash\": \"4ce6760e652277a65f05b153a5b19592\", \"hxl_header_hash\": \"f58f04743e220fb67edf3334fb27b01d\", \"headers\": [\"REGION\", \"PROV_CODE\", \"PROV_NAME\", \"DIST_CODE\", \"DIST_NAME\", \"INC_DATE\", \"INC_TYPE\", \"Persons_killed\", \"Persons_injured\", \"Families_affected\", \"Individuals_affected\", \"Houses_damaged\", \"Houses_destroyed\"], \"hxl_headers\": [\"#adm1+name+en\", \"#adm2+code\", \"#adm2+name+en\", \"#adm3+code\", \"#adm3+name+en\", \"#cause+date\", \"#cause+type\", \"#affected+killed+num\", \"#affected+injured+num\", \"#affected+families+num\", \"#affected+individuals+num\", \"#damaged+houses+num\", \"#destroyed+houses+num\"]}]}}]", "hash": "", "hdx_rel_url": "/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/3cd7b03d-6298-4796-a2a7-ab3aceff32d1/download/afghanistan-natural-disaster-incidents-from-january-to-november-2023.csv", "id": "3cd7b03d-6298-4796-a2a7-ab3aceff32d1", "last_modified": "2025-03-26T06:08:22.371375", "metadata_modified": "2025-06-03T07:20:24.667699", "microdata": false, "mimetype": "text/csv", "mimetype_inner": null, "name": "afghanistan-natural-disaster-incidents-from-january-to-november-2023.csv", "originalHash": "8750915", "package_id": "0eb7c089-7b18-442a-afeb-6380ffed95f6", "pii": "false", "position": 7, "resource_type": "file.upload", "size": 47391, "state": "active", "url": "https://data.humdata.org/dataset/0eb7c089-7b18-442a-afeb-6380ffed95f6/resource/3cd7b03d-6298-4796-a2a7-ab3aceff32d1/download/afghanistan-natural-disaster-incidents-from-january-to-november-2023.csv", "url_type": "upload"}], "tags": [{"display_name": "affected population", "id": "9f9d19d4-901f-4b57-b781-e6b2b56e2138", "name": "affected population", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "climate-weather", "id": "6f0a101d-5c57-408b-aa2a-61c078d32713", "name": "climate-weather", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "hxl", "id": "a0fbb23a-6aad-4ccc-8062-e9ef9f20e5d2", "name": "hxl", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}], "relationships_as_subject": [], "relationships_as_object": []}, {"archived": false, "batch": "ab196cbf-01a6-4087-abae-366710b5e76a", "caveats": "Kindly access the [full documentation](https://thinkingmachines.github.io/project-cchain) for more details.\r\n\r\nThe dataset is under CC By 4.0 license, with one exception, the [tm_open_buildings](https://dbdocs.io/lacuna-fund-project-team/Project-CCHAIN?table=tm_open_buildings) table, follows the [**Open Database License (ODbL)**](http://opendatacommons.org/licenses/odbl/1.0/) as directed by its source, OpenStreetMap. ", "creator_user_id": "c9cee362-993c-46ae-a788-8a818647cccb", "data_update_frequency": "-2", "dataset_date": "[2003-01-01T00:00:00 TO 2024-03-31T23:59:59]", "dataset_preview": "resource_id", "dataset_source": "Thinking Machines Data Science", "has_geodata": false, "has_showcases": false, "id": "5b580664-365e-4d7e-b5e5-2990df8f12a5", "is_requestdata_type": false, "isopen": true, "last_modified": "2024-09-30T17:15:36.089790", "license_id": "cc-by", "license_title": "Creative Commons Attribution International (CC BY)", "license_url": "http://www.opendefinition.org/licenses/cc-by", "maintainer": "c9cee362-993c-46ae-a788-8a818647cccb", "metadata_created": "2024-05-01T15:07:23.027646", "metadata_modified": "2025-04-15T16:20:16.715168", "methodology": "Other", "methodology_other": "Sources include official published data from national government agencies and institutions (DOH, PSA, Project NOAH), as well as freely-available geospatial data (Ookla, Nightlights, ERA5, MERRA, Google, ESA, OpenStreetMap, Mapbox API)\r\n\r\nEach table's data source underwent a vetting process from the project team in the health (Epimetrics), climate (Manila Observatory), environment and sociodemographic sectors (Thinking Machines, PACSII). We use official sources from government agencies (DOH, PSA, Project NOAH) when available.", "name": "project-cchain", "notes": "The **Project Climate Change, Health, and Artificial Intelligence (Project CCHAIN)** dataset is a validated, open-sourced linked dataset containing 20 years (2003-2022) of climate, environmental, socioeconomic, and health dimensions at the barangay (village) level across twelve Philippine cities (Dagupan, Palayan, Navotas, Mandaluyong, Muntinlupa, Legazpi, Iloilo, Mandaue, Tacloban, Zamboanga, Cagayan de Oro, Davao).  \r\n\r\nThe full documentation can be accessed [here](https://thinkingmachines.github.io/project-cchain).\r\n\r\nThe tables are designed in a way that users can **choose variables that are most relevant** to their focus city and use case, and **link these variables** to form a single dataset by merging using standard geography codes and calendar dates. This can be done using the provided [linking notebook](https://drive.google.com/drive/folders/123MrMXSVT6149MvJ8hGoDgN1s-YlQoH_), or offline using the user's own code.\r\n\r\n\r\nHere are some tips on how make most use of this dataset:\r\n\r\n- **Focus on one location.** Starting with a detailed analysis of one location allows for a better understanding of the local dynamics, which may differ across locations.\r\n\r\n- **Choose one health data source.** Pick one of either a central or local data source. Using two different data health sources is not advised because it will lead to double/overcounting of disease cases.\r\n\r\n- **Do not use all variables at once- do a literature review first to identify possible key variables**.  to identify possible key variables. More often than not, using all variables is not necessary and may even yield subpar results.\r\n\r\n- **Check data availability** on your focus location and make sure they fit the requirements of your study.\r\n\r\nThis dataset also includes **household surveys tables** (see schema [here](https://dbdocs.io/lacuna-fund-project-team/Project-CCHAIN?table=informal_settlement_community_surveys_v1) and [here](https://dbdocs.io/lacuna-fund-project-team/Project-CCHAIN?table=informal_settlement_community_surveys_v2))  done on partner informal settlement communities in the cities of Muntinlupa, Davao, Iloilo, and Mandaue and administered on various dates up to 2024. Due to the sensitive nature of surveys and the vulnerability of the subjects involved, requests for access must be submitted for review and approval by the Philippine Action for Community-Led Shelter Initiatives, Inc. (PACSII).\r\nTo submit a request, please use [this form](https://forms.gle/Z9rfuJFENAQfbKeM6).\r\n\r\n", "num_resources": 30, "num_tags": 4, "organization": {"id": "96a0d7cd-d523-437c-85d4-709a61db9a69", "name": "thinking-machines", "title": "Thinking Machines Data Science", "type": "organization", "description": "Thinking Machines Data Science, Inc. (Thinking Machines or TM) is technology consultancy based in Southeast Asia that builds AI and data platforms for large organizations. We work with decision-makers in both public and private sectors to bring them data-driven insights.", "image_url": "", "created": "2024-01-09T12:48:11.673465", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "96a0d7cd-d523-437c-85d4-709a61db9a69", "package_creator": "thinkingmachines", "pageviews_last_14_days": 137, "private": false, "qa_completed": false, "solr_additions": "{\"countries\": [\"Philippines\"]}", "state": "active", "subnational": "1", "title": "Philippines - Open, validated health, climate, environment and socioeconomic data", "total_res_downloads": 4750, "type": "dataset", "url": null, "version": null, "customviz": [{"url": "https://thinkingmachines.github.io/project-cchain/assets/dengue_cases_and_precipitation_dagupan.png"}, {"url": "https://thinkingmachines.github.io/project-cchain/assets/isochrone_all_cities.png"}, {"url": "https://thinkingmachines.github.io/project-cchain/assets/typhoid_water_source_muntinlupa.png"}], "groups": [{"description": "", "display_name": "Philippines", "id": "phl", "image_display_url": "", "name": "phl", "title": "Philippines"}], "resources": [{"alt_url": "https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/b93c1427-797a-40a4-b99e-872e152d1c86/download/", "cache_last_updated": null, "cache_url": null, "created": "2024-06-17T16:36:42.897730", "dataset_preview_enabled": false, "datastore_active": false, "description": "Total disease cases (morbidity) reported in Department of Health- Philippine Integrated Disease Surveillance and Response (DOH-PISDR) framework. Data is in city-weekly resolution. This data, requested by Epimetrics from their respective data owners, is governed by Data Use Agreements that allows for public use for climate and health applications.", "download_url": "https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/b93c1427-797a-40a4-b99e-872e152d1c86/download/disease_pidsr_totals.csv", "format": "CSV", "fs_check_info": "[{\"state\": \"processing\", \"message\": \"The processing of the file structure check has started\", \"timestamp\": \"2024-06-17T16:36:42.333698\"}, {\"state\": \"success\", \"message\": \"File structure check completed\", \"timestamp\": \"2024-06-17T16:36:45.238552\", \"sheet_changes\": [], \"hxl_proxy_response\": {\"url_or_filename\": \"https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/b93c1427-797a-40a4-b99e-872e152d1c86/download/disease_pidsr_totals.csv\", \"format\": \"CSV\", \"sheets\": [{\"name\": \"__DEFAULT__\", \"nrows\": 74881, \"ncols\": 9, \"is_hidden\": false, \"has_merged_cells\": false, \"is_hxlated\": false, \"header_hash\": \"06836892965284ee439767ef85fb3530\", \"hxl_header_hash\": null, \"headers\": [\"uuid\", \"freq\", \"date\", \"source_name\", \"source_filename\", \"adm3_pcode\", \"disease_icd10_code\", \"disease_common_name\", \"case_total\"], \"hxl_headers\": null}]}}]", "hash": "", "hdx_rel_url": "/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/b93c1427-797a-40a4-b99e-872e152d1c86/download/disease_pidsr_totals.csv", "id": "b93c1427-797a-40a4-b99e-872e152d1c86", "last_modified": "2024-06-17T16:36:42.603312", "metadata_modified": "2025-04-15T16:19:04.085917", "microdata": false, "mimetype": "text/csv", "mimetype_inner": null, "name": "disease_pidsr_totals.csv", "originalHash": "-988266717", "p_coded": false, "package_id": "5b580664-365e-4d7e-b5e5-2990df8f12a5", "pii": "false", "position": 0, "resource_type": "file.upload", "size": 6729620, "state": "active", "url": "https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/b93c1427-797a-40a4-b99e-872e152d1c86/download/disease_pidsr_totals.csv", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/07c85dbe-b542-44f9-aeef-34f72d877f8f/download/", "cache_last_updated": null, "cache_url": null, "created": "2024-06-17T16:38:56.504691", "dataset_preview_enabled": false, "datastore_active": false, "description": "Total disease deaths (mortality) and cases (morbidity) reported by the Department of Health- Field Health Services Information System. Data is in city-monthly resolution. This data, requested by Epimetrics from their respective data owners, is governed by Data Use Agreements that allows for public use for climate and health applications.", "download_url": "https://data.humdata.org/dataset/5b580664-365e-4d7e-b5e5-2990df8f12a5/resource/07c85dbe-b542-44f9-aeef-34f72d877f8f/download/disease_fhsis_totals.csv", "format": "CSV", "fs_check_info": "[{\"state\": \"processing\", \"message\": \"The processing of the file structure check has started\", \"timestamp\": \"2024-06-17T16:38:56.023898\"}, {\"state\": \"success\", \"message\": \"File structure check completed\", \"timestamp\": \"2024-06-17T16:38:58.724961\", \"sheet_changes\": [], \"hxl_proxy_r