048a947-5714-4220-905b-e662cbcd14c8", "position": 103, "resource_type": "file.upload", "size": 110655, "state": "active", "url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/658d5c4f-1680-4cb5-9fbf-10a0a64e2c39/download/hdx-qa-checklist.pdf", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/89546fb6-b130-4189-9da9-c962053e729f/download/", "cache_last_updated": null, "cache_url": null, "created": "2020-12-17T18:34:21.803190", "datastore_active": false, "description": "", "download_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/89546fb6-b130-4189-9da9-c962053e729f/download/pa_2020_fellow_report_final.pdf", "format": "PDF", "hash": "\"1608230101.615-339270-3310688301\"", "hdx_rel_url": "/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/89546fb6-b130-4189-9da9-c962053e729f/download/pa_2020_fellow_report_final.pdf", "id": "89546fb6-b130-4189-9da9-c962053e729f", "last_modified": "2020-12-17T18:35:01", "metadata_modified": "2025-03-10T23:35:44.937786", "microdata": false, "mimetype": "application/pdf", "mimetype_inner": null, "name": "pa_2020_fellow_report_final.pdf", "originalHash": "-988266717", "package_id": "2048a947-5714-4220-905b-e662cbcd14c8", "pii": "false", "position": 104, "resource_type": "file.upload", "size": 339270, "state": "active", "url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/89546fb6-b130-4189-9da9-c962053e729f/download/pa_2020_fellow_report_final.pdf", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/56bb190e-fd43-4573-898c-76aaedb7e10a/download/", "cache_last_updated": null, "cache_url": null, "created": "2022-02-07T18:11:03.950780", "datastore_active": false, "description": "The State of Open Humanitarian Data 2022 contains details on the data available for each location, category and sub-category covered in 27 Data Grids. It includes a country deep-dive for Somalia and showcases the work of the United Nations Population Fund on population statistics. It also has an assessment of the data required for modelling, specifically for developing anticipatory action trigger mechanisms, with examples from Ethiopia, Malawi, Nepal and the Philippines. ", "download_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/56bb190e-fd43-4573-898c-76aaedb7e10a/download/state-of-open-humanitarian-data-2022.pdf", "format": "PDF", "hash": "\"1645665552.844-3078639-3271890913\"", "hdx_rel_url": "/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/56bb190e-fd43-4573-898c-76aaedb7e10a/download/state-of-open-humanitarian-data-2022.pdf", "id": "56bb190e-fd43-4573-898c-76aaedb7e10a", "last_modified": "2022-02-24T01:19:12", "metadata_modified": "2025-03-10T23:35:44.937926", "microdata": false, "mimetype": "application/pdf", "mimetype_inner": null, "name": "State of Open Humanitarian Data 2022.pdf", "originalHash": "1987880457", "package_id": "2048a947-5714-4220-905b-e662cbcd14c8", "pii": "false", "position": 105, "resource_type": "file.upload", "size": 3078639, "state": "active", "url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/56bb190e-fd43-4573-898c-76aaedb7e10a/download/state-of-open-humanitarian-data-2022.pdf", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/8b8916fb-5be5-4840-8b11-1ebe97f27a4b/download/", "cache_last_updated": null, "cache_url": null, "created": "2021-02-09T00:32:06.229790", "datastore_active": false, "description": "The goal of this report is to increase awareness of the data that is available to inform humanitarian operations around the world and to highlight what is missing, as measured through OCHA\u2019s Humanitarian Data Exchange (HDX) platform. In a year dominated by the COVID-19 pandemic and its devastating impact on already-vulnerable populations, we saw record-breaking demand for data in the humanitarian sector coupled with persistent data gaps.", "download_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/8b8916fb-5be5-4840-8b11-1ebe97f27a4b/download/state-of-open-humanitarian-data-2021.pdf", "format": "PDF", "hash": "\"1613063211.487-2532487-2900825895\"", "hdx_rel_url": "/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/8b8916fb-5be5-4840-8b11-1ebe97f27a4b/download/state-of-open-humanitarian-data-2021.pdf", "id": "8b8916fb-5be5-4840-8b11-1ebe97f27a4b", "last_modified": "2021-02-11T17:06:51", "metadata_modified": "2025-03-10T23:35:44.938053", "microdata": false, "mimetype": "application/pdf", "mimetype_inner": null, "name": "State of Open Humanitarian Data 2021.pdf", "originalHash": 739664549, "package_id": "2048a947-5714-4220-905b-e662cbcd14c8", "pii": "false", "position": 106, "resource_type": "file.upload", "size": 2532487, "state": "active", "url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/8b8916fb-5be5-4840-8b11-1ebe97f27a4b/download/state-of-open-humanitarian-data-2021.pdf", "url_type": "upload"}, {"alt_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/053cc6a7-42aa-4286-88da-88a133e833aa/download/", "cache_last_updated": null, "cache_url": null, "created": "2020-10-29T16:55:35.346064", "datastore_active": false, "description": "", "download_url": "https://data.humdata.org/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/053cc6a7-42aa-4286-88da-88a133e833aa/download/stateofdata2020.pdf", "format": "PDF", "hash": "\"1608079425.02-3258806-3522238606\"", "hdx_rel_url": "/dataset/2048a947-5714-4220-905b-e662cbcd14c8/resource/053cc6a7-42aa-4286-88da-88a133e833aa/download/stateofdata2020.pdf", "id": "053cc6a7-42aa-4286-88da-88a133e833aa", "last_modified": "2020-12-16T00:43:45", "metadata_modified": "2025-03-10T23:35:44.938175", "microdata": false, "mimetype": "app