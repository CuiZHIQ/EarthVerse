100m/npl_agesex_structures_2030_CN_100m_R2025A_v1.zip", "url_type": "api"}, {"broken_link": true, "cache_last_updated": null, "cache_url": null, "created": "2025-05-18T23:51:04.899071", "datastore_active": false, "description": "Individual age and gender structures (1km resolution) for 2030", "download_url": "https://data.worldpop.org/GIS/AgeSex_structures/Global_2015_2030/R2025A/2030/NPL/v1/1km_ua/npl_agesex_structures_2030_CN_1km_R2025A_UA_v1.zip", "format": "GeoTIFF", "hash": "\"21b6ce7-63ca3d3dc2093\"", "hdx_rel_url": "https://data.worldpop.org/GIS/AgeSex_structures/Global_2015_2030/R2025A/2030/NPL/v1/1km_ua/npl_agesex_structures_2030_CN_1km_R2025A_UA_v1.zip", "id": "64352f6b-f078-4bf3-a3cc-45e0f0249c8c", "last_modified": "2025-09-01T00:00:00", "metadata_modified": "2026-03-23T01:42:04.162180", "microdata": false, "mimetype": null, "mimetype_inner": null, "name": "npl_agegender_structures_2030_cn_1km.zip", "package_id": "f0069b2b-9bba-45ca-a0fd-a57944e19cb4", "position": 31, "resource_type": "api", "size": 35351783, "state": "active", "url": "https://data.worldpop.org/GIS/AgeSex_structures/Global_2015_2030/R2025A/2030/NPL/v1/1km_ua/npl_agesex_structures_2030_CN_1km_R2025A_UA_v1.zip", "url_type": "api"}], "tags": [{"display_name": "baseline population", "id": "db8205e9-b61c-4df7-a987-1a2658ed8666", "name": "baseline population", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "demographics", "id": "7aa60d26-5c83-4c50-80d2-0b944fe80122", "name": "demographics", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "gender and age disaggregated data-gadd", "id": "89602a11-d872-46fc-a343-34213756030b", "name": "gender and age disaggregated data-gadd", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "geodata", "id": "2d27d72f-af37-4b38-b05e-dddc6929bd13", "name": "geodata", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}], "relationships_as_subject": [], "relationships_as_object": []}, {"archived": true, "batch": "4fda59ca-740d-49f2-b3be-6496514e12dd", "caveats": "This is a preliminary assessment and has not yet been validated in the field. It is important to consider the characteristics of the source imagery used in the analyses when interpreting results. For damage assessments it should be noted that only significant damage to the structural integrity of the buildings analyzed can be seen in imagery, while minor damage such as cracks or holes may not be visible at all. For flood extractions using radar data it is important to note that urban areas and highly vegetated areas may mask the flood signature and result in underestimation of flood waters. Users with specific questions or concerns should contact unosat@unitar.org to seek clarification.", "creator_user_id": "1a008a13-52b1-4326-a9ea-aa541372577c", "data_update_frequency": "-1", "dataset_date": "[2024-09-30T00:00:00 TO 2024-09-30T23:59:59]", "dataset_preview": "first_resource", "dataset_source": "UN Operational Satellite Applications Programme (UNOSAT)", "has_geodata": true, "has_showcases": true, "id": "af8ca279-eada-4f81-94a7-a56b47fe3781", "is_requestdata_type": false, "isopen": true, "last_modified": "2024-09-30T08:29:08", "license_id": "cc-by-sa", "license_title": "Creative Commons Attribution Share-Alike (CC BY-SA)", "license_url": "http://www.opendefinition.org/licenses/cc-by-sa", "maintainer": "83fa9515-3ba4-4f1d-9860-f38b20f80442", "metadata_created": "2024-09-30T08:37:55.732398", "metadata_modified": "2025-11-24T21:37:51.116359", "methodology": "Other", "methodology_other": "UNOSAT datasets and maps are produced using a variety of methods. In general, analysts closely review satellite imagery, often comparing two or more images together, and determine notable changes between the images. For damage assessments, refugee or IDP assessments, and similar analyses, these changes are then manually documented in the vector data by the analyst. For flood extractions, landcover mapping and similar analyses, a variety of automated remote sensing techniques are used to extract the relevant information which is then reviewed and revised as necessary by the analyst. In all cases, resulting data is then loaded into a standardized UNOSAT geodatabase and exported asshapefiles for dissemination.", "name": "water-extent-in-gandaki-lumbini-bagmati-and-madhesh-provinces-as-of-29-september-2024", "notes": "**UNOSAT code: FL20240928NPL**  This map illustrates the floods using Sentinel-1 images acquired on 29 September 2024 at 18:15 local time (12:30 UTC). Within the analysed area of about 20,000 km\u00b2, a total of about 110 km\u00b2 of land appears to be affected by flood waters. Based on Worldpop spatial demographic data, about 58,000 people are exposed or living close to flooded areas.  \nThis is a preliminary analysis and has not yet been validated in the field. Please send ground feedback to the United Nations Satellite Centre (UNOSAT).  \nImportant note: Flood analysis from radar images may underestimate the presence of standing waters in built-up areas and densely vegetated areas due to the backscattering properties of the radar signal.", "num_resources": 2, "num_tags": 2, "organization": {"id": "ba5aacba-0633-4364-9528-bc76a3f6cf95", "name": "unosat", "title": "United Nations Satellite Centre (UNOSAT)", "type": "organization", "description": "The United Nations Satellite Centre (UNOSAT) it is part of the United Nations Institute for Training and Research (UNITAR), with a mandate to provide United Nations funds, programmes and specialized agencies with satellite analysis, training and capacity development, at their request, as well as to support Member States with satellite imagery analysis over their respective territories and to provide training and capacity development in the use of geospatial information technologies.", "image_url": "", "created": "2015-01-09T15:34:40.199033", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "ba5aacba-0633-4364-9528-bc76a3f6cf95", "package_creator": "unosat", "pageviews_last_14_days": 0, "private": false, "qa_completed": false, "solr_additions": "{\"countries\": [\"Nepal\"]}", "state": "active", "subnational": "0", "title": "Satellite detected water extent in Gandaki, Lumbini, Bagmati and Madhesh Provinces as of 29 September 2024", "total_res_downloads": 14, "type": "dataset", "updated_by_script": "HDXINTERNAL:HDXPythonLibrary/6.1.3-ArchiveOldDatasets (2025-11-24T21:37:51.045875)", "url": null, "version": null, "groups": [{"description": "", "display_name": "Nepal", "id": "npl", "image_display_url": "", "name": "npl", "title": "Nepal"}], "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2024-09-30T08:37:55.743586", "datastore_active": false, "description": "Zipped geodatabase", "download_url": "https://unosat.org/static/unosat_filesystem/3986/FL20240928NPL_gdb.zip", "format": "Geodatabase", "hash": "\"66fa6154-56630\"", "hdx_rel_url": "https://unosat.org/static/unosat_filesystem/3986/FL20240928NPL_gdb.zip", "id": "d0565d48-2041-41fd-8d48-c6cc3abe00f7", "last_modified": "2024-09-30T08:29:08", "metadata_modified": "2025-08-26T15:26:14.302720", "microdata": false, "mimetype": null, "mimetype_inner": null, "name": "FL20240928NPL_gdb.zip", "package_id": "af8ca279-eada-4f81-94a7-a56b47fe3781", "position": 0, "resource_type": "api", "size": 353840, "state": "active", "url": "https://unosat.org/static/unosat_filesystem/3986/FL20240928NPL_gdb.zip", "url_type": "api"}, {"cache_last_updated": null, "cache_url": null, "created": "2024-09-30T08:37:55.743591", "datastore_active": false, "description": "Zipped shapefile", "download_url": "https://unosat.org/static/unosat_filesystem/3986/FL20240928NPL_SHP.zip", "format": "SHP", "hash": "\"66fa6154-d51c6\"", "hdx_rel_url": "https://unosat.org/static/unosat_filesystem/3986/FL20240928NPL_SHP.zip", "id": "c7c