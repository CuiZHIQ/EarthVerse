1", "dataset_date": "[2014-08-15T00:00:00 TO 2014-08-15T23:59:59]", "dataset_preview": "first_resource", "dataset_source": "OpenNepal", "has_geodata": false, "has_showcases": false, "id": "1ab6ea02-8478-44f7-be3f-4349be398580", "is_requestdata_type": false, "isopen": false, "last_modified": "2018-06-21T23:59:44.254506", "license_id": "hdx-odc-odbl", "license_title": "Open Database License (ODC-ODbL)", "license_url": "https://opendatacommons.org/licenses/odbl/1-0/", "maintainer": "e32d5afb-cc7e-4715-85b7-5a3b849443f5", "metadata_created": "2015-10-21T14:52:18.013919", "metadata_modified": "2023-08-29T14:08:45.807162", "methodology": "Other", "methodology_other": "No methodology information provided", "name": "human-casualties-due-to-major-disasters-in-nepal-1983-2013", "notes": " This dataset contains human casualties due to major disater such as flood and landslides, Earthquake, Windstorms, halitstrosm and thuderbolt, Avalanche, Fire, Cold wave, Drowning and Stampede for 1983 to 2013. The data sets is extracted from Environmental Statistics, 2013.\u00a0\r\n\u00a0(http://cbs.gov.np/wp-content/uploads/2014/07/Environment%20Statistics%20...)\r\n", "num_resources": 1, "num_tags": 2, "organization": {"id": "d066263a-50a6-481e-86fe-c0c128bfeb50", "name": "opennepal", "title": "OpenNepal (inactive)", "type": "organization", "description": "Open Nepal is a knowledge hub and a learning space for organizations and people that produce, share and use data for development or are interested to learn more about open data. By bringing together a community of practice in Nepal around topics such as the open data and access to information, Open Nepal forms a platform for people to share their experiences of using and sharing data and information, take collective action and generate solutions to common problems. The Community of Practice and Knowledge Hub contribute towards an enabling environment and build a movement for the sharing and use of (open) data for development in Nepal.", "image_url": "", "created": "2015-10-21T14:36:53.662299", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "d066263a-50a6-481e-86fe-c0c128bfeb50", "package_creator": "luiscape", "pageviews_last_14_days": 1, "private": false, "qa_completed": false, "solr_additions": "{\"countries\": [\"Nepal\"]}", "state": "active", "subnational": "0", "title": "Nepal - Human Casualties due to Major Disasters in Nepal, 1983-2013", "total_res_downloads": 14, "type": "dataset", "url": null, "version": null, "groups": [{"description": "", "display_name": "Nepal", "id": "npl", "image_display_url": "", "name": "npl", "title": "Nepal"}], "resources": [{"broken_link": true, "cache_last_updated": null, "cache_url": null, "created": "2015-10-21T19:32:15.576833", "datastore_active": false, "description": "", "download_url": "http://data.opennepal.net/sites/all/modules/pubdlcnt/pubdlcnt.php?file=http://data.opennepal.net/sites/default/files/resources/human%20casualties.csv&nid=4320", "format": "CSV", "hash": "", "hdx_rel_url": "http://data.opennepal.net/sites/all/modules/pubdlcnt/pubdlcnt.php?file=http://data.opennepal.net/sites/default/files/resources/human%20casualties.csv&nid=4320", "id": "dd876cc2-7e99-4739-baad-a33e1908f152", "last_modified": "2018-06-21T23:59:44.254506", "metadata_modified": "2023-08-29T14:08:45.881795", "microdata": false, "mimetype": null, "mimetype_inner": null, "name": "human%20casualties.csv", "originalHash": "488758896", "package_id": "1ab6ea02-8478-44f7-be3f-4349be398580", "position": 0, "resource_type": "api", "size": null, "state": "active", "url": "http://data.opennepal.net/sites/all/modules/pubdlcnt/pubdlcnt.php?file=http://data.opennepal.net/sites/default/files/resources/human%20casualties.csv&nid=4320", "url_type": "api"}], "tags": [{"display_name": "casualties", "id": "55dd6b71-e858-40de-ac52-91cd63e94cfa", "name": "casualties", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "natural disasters", "id": "48520851-7df8-418b-aa00-7fa276d7fd88", "name": "natural disasters", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}], "relationships_as_subject": [], "relationships_as_object": []}, {"archived": false, "batch": "b094dbc1-1a21-4795-b4e2-de2a7922a1b0", "caveats": "Data for earlier dates is available directly from WorldPop  \n  \nBondarenko M., Priyatikanto R., Tejedor-Garavito N., Zhang W., McKeen T., Cunningham A., Woods T., Hilton J., Cihan D., Nosatiuk B., Brinkhoff T., Tatem A., Sorichetta A.. 2025. Estimates of 2015-2030 total number of people per grid square broken down by gender and age groupings at a resolution of 3 arc (approximately 100m at the equator) R2025A version v1. Global Demographic Data Project - Funded by The Bill and Melinda Gates Foundation (INV-045237). WorldPop - School of Geography and Environmental Science, University of Southampton. DOI:10.5258/SOTON/WP00841", "creator_user_id": "1a008a13-52b1-4326-a9ea-aa541372577c", "data_update_frequency": "365", "dataset_date": "[2015-01-01T00:00:00 TO 2030-01-01T23:59:59]", "dataset_preview": "first_resource", "dataset_source": "Multiple sources", "due_date": "2031-01-01T23:59:59", "has_geodata": true, "has_showcases": true, "id": "f0069b2b-9bba-45ca-a0fd-a57944e19cb4", "is_requestdata_type": false, "isopen": false, "last_modified": "2025-09-01T00:00:00", "license_id": "hdx-other", "license_other": "[WorldPop licence information](https://hub.worldpop.org/data/licence.txt)", "license_title": "Other", "maintainer": "37023db4-a571-4f28-8d1f-15f0353586af", "metadata_created": "2025-03-14T04:54:28.696806", "metadata_modified": "2026-03-23T01:42:04.131118", "methodology": "Other", "methodology_other": "Methodology information can be found in the [Release Statement](https://data.worldpop.org/repo/prj/Global_2015_2030/R2025A/doc/Global2_Release_Statement_R2025A_v1.pdf)", "name": "worldpop-age-and-gender-structures-2015-2030-npl", "notes": "Estimates of total number of people per grid square broken down by gender and age groupings (including 0-1 and by 5-year up to 90+) for Nepal, R2025A version v1. The dataset is available to download in Geotiff format at a resolution of 3 arc (approximately 100m at the equator). The projection is Geographic Coordinate System, WGS84. The units are estimated number of male, female or both in each age group per grid square.&nbsp;  \n  \nMore information can be found in the [Release Statement](https://data.worldpop.org/repo/prj/Global_2015_2030/R2025A/doc/Global2_Release_Statement_R2025A_v1.pdf)  \n  \nPlease note that these data represent 2025 Alpha release versions, constructed in September 2025  \n  \n**File Descriptions:**  \n  \n_{iso}\u00a0{gender}\u00a0{age group}\u00a0{year}\u00a0{type}\u00a0{resolution}.tif_  \n  \n_iso_  \n  \nThree-letter country code  \n  \n_gender_  \n  \nm = male, f= female, t = both genders  \n  \n_age group_  \n  \n*   00 = age group 0 to 12 months  \n*   01 = age group 1 to 4 years  \n*   05 = age group 5 to 9 years  \n*   90 = age 90 years and over  \n  \n_year_  \n  \nYear that the population represents  \n  \n_type_  \n  \nCN = [Constrained](https://www.worldpop.org/methods/top_down_constrained_vs_unconstrained/)  \n  \n_resolution_  \n  \nResolution of the data e.q. 100m = 3 arc (approximately 100m at the equator)", "num_resources": 32, "num_tags": 4, "organization": {"id": "3f077dff-1d05-484d-a7c2-4cb620f22689", "name": "worldpop", "title": "WorldPop", "type": "organization", "description": "WorldPop works to ensure that every person is mapped and counted in decision making. WorldPop is an applied research and implementation group based at the University of Southampton and develops open, academically peer-reviewed methods for mapping populations at high spatial resolution across the globe. Since 2013, they have partnered with governments, UN agencies and donors to construct more than 45,000 demographic datasets, complementing traditional population sources with dynamic, high-resolution data from satellites and cellphones for mapping human population distributions.", "image_url": "", "created": "2016-02-01T21:28:01.511795", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "3f077dff-1d05-484d-a7c2-4cb620f22689", "package_creator": "mcarans", "pageviews_last_14_days": 4, "private": false, "qa_completed": false, "solr_additions": "{\"countries\": [\"Nepal\"]}", "state": "active", "subnational": "1", "title": "Nepal - Age and Gender Structures (2015-2030)", "total_res_downloads": 107, "type": "dataset", "updated_by_script": "HDX Scraper: WorldPop (2026-03-23T01:42:03.945355)", "url": null, "version": null, "groups": [{"description": "", "display_name": "Nepal", "id": "npl", "image_display_url": "", "name": "npl", "title": "Nepal"}], "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2025-03-14T04:54:28.699318", "datastore_active": false, "description": "Individual age and gender structures (100m resolution) for 2015", "download_url": "https://data.worldpop.org/GIS/AgeSex_structures/Global_2015_2030/R2025A/2015/NPL/v1/100m/npl_agesex_structures_2015_CN_100m_R2025A_v1.zip", "format": "GeoTIFF", "hash": "\"6975b808-63c78ea7b07a7\"", "hdx_rel_url": "https://data.worldpop.org/GIS/AgeSex_structures/Global_2015_2030/R2025A/2015/NPL/v1/100m/npl_agesex_structures_2015_CN_100m_R2025A_v1.zip", "id": "25cd9883-887c-4a2f-a6f5-536f5a79d223", "last_modified": "2025-09-01T00:00:00", "metadata_modified": "2026-03-23T01:42:04.159343", "microdata": false, "mimetype": null, "mimetype_inner": null, "name": "npl_agegender_structures_2015_cn_100m.zip", "package_id": "f0069b2b-9bba-45ca-a0fd-a57944e19cb4", "position": 0, "resource_type": "api", "size": 1769322504, "state": "active", "url": "https://data.worldpop.org/GIS/AgeSex_structures/Global_2015_2030/R2025A/2015/NPL/v1/100m/npl_agesex_structures_2015_CN_100m_R2025A_v1.zip", "url_type": "api"}, {"broken_link": true, "ca