"}, {\"field_name\": \"shape_leng\", \"data_type\": \"character varying\"}, {\"field_name\": \"shape_area\", \"data_type\": \"character varying\"}, {\"field_name\": \"water_clas\", \"data_type\": \"character varying\"}, {\"field_name\": \"sensor_id\", \"data_type\": \"character varying\"}, {\"field_name\": \"sensor_dat\", \"data_type\": \"date\"}, {\"field_name\": \"confidence\", \"data_type\": \"character varying\"}, {\"field_name\": \"field_vali\", \"data_type\": \"character varying\"}, {\"field_name\": \"water_stat\", \"data_type\": \"character varying\"}, {\"field_name\": \"notes\", \"data_type\": \"character varying\"}, {\"field_name\": \"area_m2\", \"data_type\": \"character varying\"}, {\"field_name\": \"area_ha\", \"data_type\": \"character varying\"}, {\"field_name\": \"senorid_ol\", \"data_type\": \"character varying\"}, {\"field_name\": \"staffid\", \"data_type\": \"character varying\"}, {\"field_name\": \"eventcode\", \"data_type\": \"character varying\"}, {\"field_name\": \"wkb_geometry\", \"data_type\": \"USER-DEFINED\"}], \"timestamp\": \"2024-09-30T08:38:08.777993\"}]", "size": 872902, "state": "active", "url": "https://unosat.org/static/unosat_filesystem/3983/FL20240928NPL_SHP.zip", "url_type": "api"}, {"cache_last_updated": null, "cache_url": null, "created": "2024-09-29T08:36:18.115396", "datastore_active": false, "description": "Excel file", "download_url": "https://unosat.org/static/unosat_filesystem/3983/UNOSAT_Population_Exposure_FL20240928NPL_27Sep2024.xlsx", "format": "XLSX", "hash": "\"66f7ecdc-2f4c\"", "hdx_rel_url": "https://unosat.org/static/unosat_filesystem/3983/UNOSAT_Population_Exposure_FL20240928NPL_27Sep2024.xlsx", "id": "ca207b89-b9c9-412a-8eea-9df0f798414c", "last_modified": "2024-09-28T11:47:40", "metadata_modified": "2025-08-26T12:24:49.125354", "microdata": false, "mimetype": null, "mimetype_inner": null, "name": "UNOSAT_Population_Exposure_FL20240928NPL_27Sep2024.xlsx", "package_id": "36b3ad18-19d9-4fa3-8a42-d7c7b17adb41", "position": 2, "resource_type": "api", "size": 12108, "state": "active", "url": "https://unosat.org/static/unosat_filesystem/3983/UNOSAT_Population_Exposure_FL20240928NPL_27Sep2024.xlsx", "url_type": "api"}], "tags": [{"display_name": "flooding", "id": "532eacf2-7b8c-4dd5-baf7-c25720cadb38", "name": "flooding", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}, {"display_name": "geodata", "id": "2d27d72f-af37-4b38-b05e-dddc6929bd13", "name": "geodata", "state": "active", "vocabulary_id": "b891512e-9516-4bf5-962a-7a289772a2a1"}], "relationships_as_subject": [], "relationships_as_object": []}, {"archived": true, "batch": "0cc345d9-764a-46af-9fa1-26db892718ab", "caveats": "This is a preliminary assessment and has not yet been validated in the field. It is important to consider the characteristics of the source imagery used in the analyses when interpreting results. For damage assessments it should be noted that only significant damage to the structural integrity of the buildings analyzed can be seen in imagery, while minor damage such as cracks or holes may not be visible at all. For flood extractions using radar data it is important to note that urban areas and highly vegetated areas may mask the flood signature and result in underestimation of flood waters. Users with specific questions or concerns should contact unosat@unitar.org to seek clarification.", "creator_user_id": "1a008a13-52b1-4326-a9ea-aa541372577c", "data_update_frequency": "-1", "dataset_date": "[2024-10-02T00:00:00 TO 2024-10-02T23:59:59]", "dataset_preview": "first_resource", "dataset_source": "UN Operational Satellite Applications Programme (UNOSAT)", "has_geodata": true, "has_showcases": true, "id": "8ea0b8d8-4a46-44cd-aa18-8bc2ce4a2dd2", "is_requestdata_type": false, "isopen": true, "last_modified": "2024-10-03T06:58:16", "license_id": "cc-by-sa", "license_title": "Creative Commons Attribution Share-Alike (CC BY-SA)", "license_url": "http://www.opendefinition.org/licenses/cc-by-sa", "maintainer": "83fa9515-3ba4-4f1d-9860-f38b20f80442", "metadata_created": "2024-10-04T08:37:16.722034", "metadata_modified": "2025-11-24T21:37:54.172176", "methodology": "Other", "methodology_other": "UNOSAT datasets and maps are produced using a variety of methods. In general, analysts closely review satellite imagery, often comparing two or more images together, and determine notable changes between the images. For damage assessments, refugee or IDP assessments, and similar analyses, these changes are then manually documented in the vector data by the analyst. For flood extractions, landcover mapping and similar analyses, a variety of automated remote sensing techniques are used to extract the relevant information which is then reviewed and revised as necessary by the analyst. In all cases, resulting data is then loaded into a standardized UNOSAT geodatabase and exported asshapefiles for dissemination.", "name": "satellite-detected-water-extent-koshi-and-madhesh-provinces-nepal-as-of-01-october-2024", "notes": "**UNOSAT code: FL20240928NPL**  This map illustrates the floods using Sentinel-1 images acquired on 01 October 2024 at 17:59 local time (12:14 UTC). Within the analysed area of about 6,000 km\u00b2, a total of about 55 km\u00b2 of land appears to be affected by flood waters. Based on Worldpop spatial demographic data, about 18,000 people are exposed or living close to flooded areas. Water extent seems to have increased by about 14 km\u00b2 since 27 September 2024  \n  \nThis is a preliminary analysis and has not yet been validated in the field. Please send ground feedback to the United Nations Satellite Centre (UNOSAT).  \n  \nImportant note: Flood analysis from radar images may underestimate the presence of standing waters in built-up areas and densely vegetated areas due to the backscattering properties of the radar signal.", "num_resources": 3, "num_tags": 2, "organization": {"id": "ba5aacba-0633-4364-9528-bc76a3f6cf95", "name": "unosat", "titl