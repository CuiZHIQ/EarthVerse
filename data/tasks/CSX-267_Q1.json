  "compute_gt_py": "#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport csv\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\n\nTASK_ID = \"CSX-267_Q1\"\nPACKAGE_ID = \"CSX-267\"\nEVENT_START = \"2023-06-01\"\nEVENT_END = \"2024-05-31\"\n\nSOURCE_FILES = [\n    \"metadata/event.json\",\n    \"metadata/files.csv\",\n    \"data/event_reports/event_reports_002_Locked_event_anchor_2023-2024_El_Nino_episode.json\",\n    \"data/physical_hazard/physical_hazard_006_NOAA_CPC_ONI_ASCII.txt\",\n    \"data/physical_hazard/physical_hazard_008_NOAA_PSL_SOI_data.data\",\n]\n\nEVENT_ONI_KEYS = [\n    (2023, \"MJJ\"),\n    (2023, \"JJA\"),\n    (2023, \"JAS\"),\n    (2023, \"ASO\"),\n    (2023, \"SON\"),\n    (2023, \"OND\"),\n    (2023, \"NDJ\"),\n    (2024, \"DJF\"),\n    (2024, \"JFM\"),\n    (2024, \"FMA\"),\n    (2024, \"MAM\"),\n    (2024, \"AMJ\"),\n]\n\nEVENT_SOI_MONTHS = [(2023, month) for month in range(6, 13)] + [\n    (2024, month) for month in range(1, 6)\n]\n\n\ndef package_dir() -> Path:\n    repo_root = Path(__file__).resolve().parents[3]\n    return repo_root / \"event_packages\" / \"standard_event_packages\" / \"packages\" / PACKAGE_ID\n\n\ndef read_json(root: Path, rel_path: str) -> dict[str, Any]:\n    return json.loads((root / rel_path).read_text(encoding=\"utf-8\"))\n\n\ndef read_files_manifest(root: Path) -> list[dict[str, str]]:\n    with (root / \"metadata\" / \"files.csv\").open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as handle:\n        return list(csv.DictReader(handle))\n\n\ndef parse_oni(path: Path) -> list[dict[str, Any]]:\n    rows: list[dict[str, Any]] = []\n    for line in path.read_text(encoding=\"utf-8\").splitlines():\n        parts = line.split()\n        if len(parts) != 4 or parts[0] == \"SEAS\":\n            continue\n        rows.append(\n            {\n                \"season\": parts[0],\n                \"year\": int(parts[1]),\n                \"total\": float(parts[2]),\n                \"anom\": float(parts[3]),\n            }\n        )\n    return rows\n\n\ndef event_oni_rows(rows: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    by_key = {(row[\"year\"], row[\"season\"]): row for row in rows}\n    missing = [key for key in EVENT_ONI_KEYS if key not in by_key]\n    if missing:\n        raise RuntimeError(f\"ONI event rows missing: {missing}\")\n    return [by_key[key] for key in EVENT_ONI_KEYS]\n\n\ndef parse_soi(path: Path) -> dict[int, list[float]]:\n    table: dict[int, list[float]] = {}\n    for line in path.read_text(encoding=\"utf-8\").splitlines():\n        parts = line.split()\n        if len(parts) == 13 and parts[0].isdigit():\n            table[int(parts[0])] = [float(value) for value in parts[1:]]\n    return table\n\n\ndef event_soi_values(table: dict[int, list[float]]) -> list[float]:\n    values: list[float] = []\n    for year, month in EVENT_SOI_MONTHS:\n        value = table[year][month - 1]\n        if value == -99.99:\n            raise RuntimeError(f\"SOI missing value for {year}-{month:02d}\")\n        values.append(value)\n    return values\n\n\ndef longest_true_run(values: list[bool]) -> int:\n    best = 0\n    current = 0\n    for value in values:\n        current = current + 1 if value else 0\n        best = max(best, current)\n    return best\n\n\ndef round2(value: float) -> float:\n    return round(float(value), 2)\n\n\ndef row_label(row: dict[str, Any]) -> str:\n    return f\"{row['season']} {row['year']} {row['anom']:.2f}\"\n\n\ndef score_components(\n    warm_run: int,\n    strong_run: int,\n    peak_oni: float,\n    final_oni: float,\n    soi_mean: float,\n    soi_negative_months: int,\n) -> dict[str, float]:\n    return {\n        \"warm\": 40 * (warm_run / 12),\n        \"strong\": 25 * (strong_run / 12),\n        \"peak\": 15 * (peak_oni / 2.5),\n        \"soi_count\": 15 * (soi_negative_months / 12),\n        \"soi_mean\": 5 * min(abs(soi_mean), 1),\n        \"late_penalty\": 10 * max(0, 0.5 - final_oni),\n    }\n\n\ndef build_rubric() -> dict[str, Any]:\n    return {\n        \"total_points\": 20,\n        \"criteria\": [\n            {\n                \"name\": \"ONI event extraction\",\n                \"points\": 4,\n                \"description\": \"Uses the 12 stated overlapping ONI seasons in order.\",\n            },\n            {\n                \"name\": \"ONI threshold ledger\",\n                \"points\": 4,\n                \"description\": \"Computes warm_run 11, strong_run 6, peak_oni 2.06, and final_oni 0.49.\",\n            },\n            {\n                \"name\": \"SOI ledger\",\n                \"points\": 4,\n                \"description\": \"Uses the 12 event SOI months and computes mean -0.53 with 8 negative months.\",\n            },\n            {\n                \"name\": \"Score arithmetic\",\n                \"points\": 5,\n                \"description\": \"Applies the formula terms, cap, and late-row deduction to obtain 74.09 within 0.02.\",\n            },\n            {\n                \"name\": \"Auditable derivation\",\n                \"points\": 3,\n                \"description\": \"Shows enough intermediate arithmetic to reproduce the numeric result.\",\n            },\n        ],\n    }\n\n\ndef build_gt() -> dict[str, Any]:\n    root = package_dir()\n    event = read_json(root, \"metadata/event.json\")\n    anchor = read_json(root, SOURCE_FILES[2])\n    manifest = read_files_manifest(root)\n\n    oni_rows = event_oni_rows(parse_oni(root / SOURCE_FILES[3]))\n    oni_values = [row[\"anom\"] for row in oni_rows]\n    warm_run = longest_true_run([value >= 0.5 for value in oni_values])\n    strong_run = longest_true_run([value >= 1.5 for value in oni_values])\n    peak = max(oni_rows, key=lambda row: row[\"anom\"])\n    final_row = oni_rows[-1]\n    oni_mean = sum(oni_values) / len(oni_values)\n    warm_load = sum(max(0.0, value - 0.5) for value in oni_values)\n\n    soi_values = event_soi_values(parse_soi(root / SOURCE_FILES[4]))\n    soi_mean = sum(soi_values) / len(soi_values)\n    soi_negative_months = sum(value < 0 for value in soi_values)\n    soi_negative_run = longest_true_run([value < 0 for value in soi_values])\n\n    components_raw = score_components(\n        warm_run=warm_run,\n        strong_run=strong_run,\n        peak_oni=peak[\"anom\"],\n        final_oni=final_row[\"anom\"],\n        soi_mean=soi_mean,\n        soi_negative_months=soi_negative_months,\n    )\n    score = sum(value for key, value in components_raw.items() if key != \"late_penalty\")\n    score -= components_raw[\"late_penalty\"]\n\n    components = {key: round2(value) for key, value in components_raw.items()}\n    inputs = {\n        \"oni_n\": len(oni_rows),\n        \"warm_run\": warm_run,\n        \"strong_run\": strong_run,\n        \"peak_oni\": round2(peak[\"anom\"]),\n        \"final_oni\": round2(final_row[\"anom\"]),\n        \"soi_n\": len(soi_values),\n        \"soi_mean\": round2(soi_mean),\n        \"soi_negative_months\": soi_negative_months,\n    }\n\n    return {\n        \"schema_version\": \"1.0\",\n        \"task_id\": TASK_ID,\n        \"event_id\": PACKAGE_ID,\n        \"task_type\": \"numeric\",\n        \"target_family\": \"coupled_el_nino_persistence_score_ledger\",\n        \"evaluation_mode\": \"deterministic\",\n        \"difficulty_level\": \"L3\",\n        \"primary_gt\": {\n            \"answer\": round2(score),\n            \"score_name\": \"coupled_persistence_score\",\n            \"tolerance\": 0.02,\n            \"formula\": \"40*(warm_run/12)+25*(strong_run/12)+15*(peak_oni/2.5)+15*(soi_negative_months/12)+5*min(abs(soi_mean),1)-10*max(0,0.5-final_oni)\",\n            \"inputs\": inputs,\n            \"components\": components,\n        },\n        \"rubric\": build_rubric(),\n        \"event\": {\n            \"package_id\": PACKAGE_ID,\n            \"event_name\": event[\"event_name\"],\n            \"event_date_or_window\": f\"{EVENT_START}/{EVENT_END}\",\n            \"scale\": event[\"scale\"],\n            \"region\": event[\"region\"],\n        },\n        \"key_values\": {\n            \"manifest_file_count\": len(manifest),\n            \"anchor_scope\": anchor[\"locked_event_anchor\"][\"event_scope\"],\n            \"oni_first\": row_label(oni_rows[0]),\n            \"oni_peak\": row_label(peak),\n            \"oni_final\": row_label(final_row),\n            \"oni_mean\": round2(oni_mean),\n            \"oni_warm_load_above_0p5\": round2(warm_load),\n            \"soi_longest_negative_run\": soi_negative_run,\n            \"score_terms\": components,\n        },\n        \"provenance\": {\n            \"computed_by\": \"compute_gt.py\",\n            \"source_files\": SOURCE_FILES,\n        },\n    }\n\n\ndef main() -> None:\n    output = build_gt()\n    out_path = Path(__file__).resolve().parent / \"computed_gt.json\"\n    out_path.write_text(json.dumps(output, indent=2, ensure_ascii=True) + \"\\n\", encoding=\"utf-8\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
