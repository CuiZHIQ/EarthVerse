  "compute_gt_py": "#!/usr/bin/env python3\n\"\"\"Compute the deterministic ground truth for CSX-323 Q2.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport re\nfrom datetime import date\nfrom pathlib import Path\nfrom typing import Any\n\n\nTASK_ID = \"CSX-323_Q2\"\nPACKAGE_ID = \"CSX-323\"\n\nSOURCE_FILES = [\n    \"metadata/event.json\",\n    \"data/event_reports/event_reports_003_Locked_event_anchor_2013-2016_Northeast_Pacific_marine_heatwave_The_Blob.json\",\n    \"data/other/other_002_01_event_specific_wikipedia_search_Wikipedia_search_for_exact_event_name.json.json\",\n]\n\n\ndef read_json(package_dir: Path, rel_path: str) -> dict[str, Any]:\n    return json.loads((package_dir / rel_path).read_text(encoding=\"utf-8\"))\n\n\ndef inclusive_days(start_text: str, end_text: str) -> int:\n    start = date.fromisoformat(start_text)\n    end = date.fromisoformat(end_text)\n    return (end - start).days + 1\n\n\ndef clean_text(text: str) -> str:\n    text = re.sub(r\"<[^>]+>\", \" \", text)\n    text = (\n        text.replace(\"&quot;\", '\"')\n        .replace(\"&#039;\", \"'\")\n        .replace(\"&amp;\", \"&\")\n        .replace(\"\\u2014\", \"-\")\n        .replace(\"\\u2013\", \"-\")\n    )\n    return re.sub(r\"\\s+\", \" \", text).strip()\n\n\ndef count_occurrences(text: str, patterns: list[str]) -> int:\n    total = 0\n    for pattern in patterns:\n        total += len(re.findall(pattern, text, flags=re.IGNORECASE))\n    return total\n\n\ndef main() -> None:\n    repo_root = Path(__file__).resolve().parents[3]\n    package_dir = repo_root / \"event_packages\" / \"standard_event_packages\" / \"packages\" / PACKAGE_ID\n\n    event_meta = read_json(package_dir, SOURCE_FILES[0])\n    anchor = read_json(package_dir, SOURCE_FILES[1])\n    wiki_search = read_json(package_dir, SOURCE_FILES[2])\n\n    window = anchor[\"temporal_window\"]\n    event_window_days = inclusive_days(window[\"start_date\"], window[\"end_date\"])\n    event_window_years = round(event_window_days / 365.0, 2)\n    source_result_count = int(wiki_search[\"query\"][\"searchinfo\"][\"totalhits\"])\n\n    snippets = [\n        clean_text(result.get(\"title\", \"\") + \" \" + result.get(\"snippet\", \"\"))\n        for result in wiki_search.get(\"query\", {}).get(\"search\", [])\n    ]\n    snippet_text = \" \".join(snippets)\n    evidence_text = \" \".join(\n        [\n            event_meta[\"event_name\"],\n            event_meta[\"hazard_family\"],\n            event_meta[\"hazard_label\"],\n            event_meta[\"region\"],\n            snippet_text,\n        ]\n    )\n\n    marine_heatwave_term_count = count_occurrences(\n        evidence_text,\n        [r\"marine heatwave\", r\"\\bBlob\\b\", r\"warm Blob\"],\n    )\n    ecosystem_impact_term_count = count_occurrences(\n        snippet_text,\n        [r\"ecological impacts?\", r\"toxic algal bloom\", r\"harmful algal bloom\", r\"algal blooms?\", r\"food[- ]web\"],\n    )\n    northeast_pacific_reference_count = count_occurrences(\n        evidence_text,\n        [r\"Northeast Pacific\", r\"Northeastern Pacific\", r\"northeast Pacific\", r\"Pacific Ocean\"],\n    )\n\n    tests = {\n        \"hazard_family\": event_meta.get(\"hazard_family\") == \"marine_heatwave_coastal_ecosystem\",\n        \"basin_scope\": anchor[\"locked_event_anchor\"][\"event_scope\"] == \"basin\",\n        \"long_window\": event_window_days >= 365,\n        \"marine_heatwave_terms\": marine_heatwave_term_count >= 3,\n        \"ecosystem_impact_terms\": ecosystem_impact_term_count >= 1,\n        \"northeast_pacific_context\": northeast_pacific_reference_count >= 1,\n    }\n    score = sum(1 for passed in tests.values() if passed)\n    final_label = \"scale_window_pass\" if score == 6 else \"scale_window_fail\"\n\n    output = {\n        \"schema_version\": \"1.0\",\n        \"task_id\": TASK_ID,\n        \"event_id\": PACKAGE_ID,\n        \"task_type\": \"numeric\",\n        \"target_family\": \"scale_window_evidence_summary\",\n        \"evaluation_mode\": \"deterministic\",\n        \"difficulty_level\": \"L2\",\n        \"primary_gt\": {\n            \"answer\": final_label,\n            \"event_window_days\": event_window_days,\n            \"event_window_years\": event_window_years,\n            \"source_result_count\": source_result_count,\n            \"marine_heatwave_term_count\": marine_heatwave_term_count,\n            \"ecosystem_impact_term_count\": ecosystem_impact_term_count,\n            \"northeast_pacific_reference_count\": northeast_pacific_reference_count,\n            \"score\": score,\n            \"final_label\": final_label,\n        },\n        \"decision_rule\": {\n            \"score_max\": 6,\n            \"pass_label\": \"scale_window_pass\",\n            \"fail_label\": \"scale_window_fail\",\n            \"tests\": tests,\n            \"thresholds\": {\n                \"min_event_days\": 365,\n                \"min_marine_heatwave_term_count\": 3,\n                \"min_ecosystem_impact_term_count\": 1,\n                \"min_northeast_pacific_reference_count\": 1,\n            },\n        },\n        \"numeric_tolerances\": {\n            \"event_window_days\": 0,\n            \"event_window_years\": 0.01,\n            \"source_result_count\": 0,\n            \"marine_heatwave_term_count\": 0,\n            \"ecosystem_impact_term_count\": 0,\n            \"northeast_pacific_reference_count\": 0,\n            \"score\": 0,\n        },\n        \"rubric\": {\n            \"total_points\": 20,\n            \"criteria\": [\n                {\n                    \"name\": \"answer_schema\",\n                    \"points\": 4,\n                    \"description\": \"Provides the requested compact JSON with all required fields and rounding.\",\n                },\n                {\n                    \"name\": \"window_math\",\n                    \"points\": 4,\n                    \"description\": \"Computes 1127 inclusive days and the 3.09-year duration from the locked event window.\",\n                },\n                {\n                    \"name\": \"text_evidence_counts\",\n                    \"points\": 4,\n                    \"description\": \"Counts the 6 source results, 14 marine-heatwave terms, 6 ecosystem-impact terms, and 6 Northeast Pacific references.\",\n                },\n                {\n                    \"name\": \"score_logic\",\n                    \"points\": 4,\n                    \"description\": \"Applies the six evidence tests without using short point-weather, Sentinel-2, or other land-product samples.\",\n                },\n                {\n                    \"name\": \"final_label\",\n                    \"points\": 2,\n                    \"description\": \"Returns scale_window_pass only when all six tests pass.\",\n                },\n                {\n                    \"name\": \"numeric_scope\",\n                    \"points\": 2,\n                    \"description\": \"Keeps out unmeasured mortality, economic totals, service-disruption totals, and non-event land-product proxies.\",\n                },\n            ],\n        },\n        \"provenance\": {\n            \"computed_by\": \"compute_gt.py\",\n            \"source_files\": SOURCE_FILES,\n        },\n    }\n\n    (Path(__file__).resolve().parent / \"computed_gt.json\").write_text(\n        json.dumps(output, ensure_ascii=True, indent=2, sort_keys=True) + \"\\n\",\n        encoding=\"utf-8\",\n    )\n\n\nif __name__ == \"__main__\":\n    main()\n",
