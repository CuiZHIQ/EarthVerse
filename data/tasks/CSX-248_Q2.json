  "compute_gt_py": "#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\n\nfrom PIL import Image, ImageStat\n\n\nTASK_ID = \"CSX-248_Q2\"\nTARGET_FAMILY = \"remote_sensing_scene_change_numeric\"\nPACKAGE_RELATIVE_PATH = \"event_packages/standard_event_packages/packages/CSX-248\"\nSOURCE_FILES = [\n    \"metadata/event.json\",\n    \"data/remote_sensing/remote_sensing_002_Google_Satellite_Embedding_annual_cosine-change_stats.json\",\n    \"data/remote_sensing/remote_sensing_003_pre.jpg\",\n    \"data/remote_sensing/remote_sensing_004_event.jpg\",\n]\n\n\ndef repo_root() -> Path:\n    return Path(__file__).resolve().parents[3]\n\n\ndef package_root() -> Path:\n    return repo_root() / PACKAGE_RELATIVE_PATH\n\n\ndef load_json(rel_path: str) -> dict:\n    with (package_root() / rel_path).open(\"r\", encoding=\"utf-8-sig\") as handle:\n        return json.load(handle)\n\n\ndef iter_rgb_pixels(image: Image.Image):\n    if hasattr(image, \"get_flattened_data\"):\n        data = image.get_flattened_data()\n    else:\n        data = image.getdata()\n    for pixel in data:\n        if isinstance(pixel, (list, tuple)):\n            yield tuple(pixel[:3])\n        else:\n            yield (pixel, pixel, pixel)\n\n\ndef image_stats(rel_path: str) -> dict:\n    image = Image.open(package_root() / rel_path).convert(\"RGB\")\n    stat = ImageStat.Stat(image)\n    width, height = image.size\n    total = width * height\n    green_count = 0\n    for r, g, b in iter_rgb_pixels(image):\n        if g > r and g > b:\n            green_count += 1\n    green_dominant = green_count / total\n    return {\n        \"size\": list(image.size),\n        \"mean_rgb\": [round(value, 2) for value in stat.mean],\n        \"mean_brightness\": round(sum(stat.mean) / 3, 2),\n        \"green_dominant_share\": round(green_dominant, 4),\n    }\n\n\ndef build_gt() -> dict:\n    event = load_json(SOURCE_FILES[0])\n    change = load_json(SOURCE_FILES[1])[\"stats\"]\n    pre = image_stats(SOURCE_FILES[2])\n    during = image_stats(SOURCE_FILES[3])\n\n    brightness_delta = round(during[\"mean_brightness\"] - pre[\"mean_brightness\"], 2)\n    green_share_delta = round(\n        during[\"green_dominant_share\"] - pre[\"green_dominant_share\"], 4\n    )\n    annual_change_mean = round(change[\"alphaearth_1_minus_cosine_mean\"], 4)\n    annual_change_max = round(change[\"alphaearth_1_minus_cosine_max\"], 4)\n    spatial_change_ratio = round(annual_change_max / annual_change_mean, 2)\n    contrast_index = round(abs(brightness_delta) * spatial_change_ratio / 100, 2)\n\n    primary_gt = {\n        \"target_family\": TARGET_FAMILY,\n        \"brightness_delta\": brightness_delta,\n        \"green_share_delta\": green_share_delta,\n        \"spatial_change_ratio\": spatial_change_ratio,\n        \"contrast_index\": contrast_index,\n    }\n\n    return {\n        \"schema_version\": \"1.0\",\n        \"task_id\": TASK_ID,\n        \"event_id\": event[\"package_id\"],\n        \"task_type\": \"numeric\",\n        \"target_family\": TARGET_FAMILY,\n        \"evaluation_mode\": \"deterministic\",\n        \"difficulty_level\": \"L2\",\n        \"primary_gt\": primary_gt,\n        \"numeric_tolerances\": {\n            \"brightness_delta\": {\"value\": brightness_delta, \"tolerance\": 0.05},\n            \"green_share_delta\": {\"value\": green_share_delta, \"tolerance\": 0.0005},\n            \"spatial_change_ratio\": {\"value\": spatial_change_ratio, \"tolerance\": 0.05},\n            \"contrast_index\": {\"value\": contrast_index, \"tolerance\": 0.05},\n        },\n        \"key_values\": {\n            \"pre_image\": pre,\n            \"event_image\": during,\n            \"annual_change_mean\": annual_change_mean,\n            \"annual_change_max\": annual_change_max,\n        },\n        \"rubric\": {\n            \"total_points\": 20,\n            \"criteria\": [\n                {\n                    \"name\": \"Target family and JSON shape\",\n                    \"points\": 3,\n                    \"description\": \"Returns the requested numeric JSON with the expected target family.\",\n                },\n                {\n                    \"name\": \"Brightness delta\",\n                    \"points\": 4,\n                    \"description\": \"Computes event-period minus pre-event mean brightness within tolerance.\",\n                },\n                {\n                    \"name\": \"Green-share delta\",\n                    \"points\": 4,\n                    \"description\": \"Computes event-period minus pre-event green-dominant pixel share within tolerance.\",\n                },\n                {\n                    \"name\": \"Spatial-change ratio\",\n                    \"points\": 4,\n                    \"description\": \"Computes annual spatial-change maximum divided by mean within tolerance.\",\n                },\n                {\n                    \"name\": \"Contrast index\",\n                    \"points\": 3,\n                    \"description\": \"Computes the formula using the rounded brightness delta and spatial-change ratio.\",\n                },\n                {\n                    \"name\": \"Concision and numeric discipline\",\n                    \"points\": 2,\n                    \"description\": \"Keeps the result numeric and limited to measured image and change-stat fields.\",\n                },\n            ],\n        },\n        \"provenance\": {\n            \"computed_by\": \"compute_gt.py\",\n            \"source_files\": SOURCE_FILES,\n        },\n    }\n\n\ndef main() -> None:\n    output = Path(__file__).resolve().parent / \"computed_gt.json\"\n    output.write_text(\n        json.dumps(build_gt(), indent=2, ensure_ascii=True) + \"\\n\",\n        encoding=\"utf-8\",\n    )\n\n\nif __name__ == \"__main__\":\n    main()\n",
