  "compute_gt_py": "#!/usr/bin/env python3\n\"\"\"Compute ground truth for CSX-297_Q2.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\n\nTASK_ID = \"CSX-297_Q2\"\nEVENT_ID = \"CSX-297\"\nSOURCE_FILES = [\n    \"metadata/event.json\",\n    \"data/event_reports/event_reports_003_Locked_event_anchor_2019_Indonesian_haze_and_smoke.json\",\n    \"data/physical_hazard/physical_hazard_002_Open-Meteo_archive_point_sample.json\",\n    \"data/physical_hazard/physical_hazard_003_ERA5-Land_hourly_aggregate_stats.json\",\n    \"data/physical_hazard/physical_hazard_004_GPM_IMERG_V07_event_accumulated_precipitation.json\",\n    \"data/physical_hazard/physical_hazard_006_CHIRPS_daily_event_accumulated_precipitation.json\",\n]\n\n\ndef package_dir() -> Path:\n    repo_root = Path(__file__).resolve().parents[3]\n    return repo_root / \"event_packages\" / \"standard_event_packages\" / \"packages\" / EVENT_ID\n\n\ndef read_json(root: Path, rel_path: str) -> dict[str, Any]:\n    with (root / rel_path).open(\"r\", encoding=\"utf-8-sig\") as handle:\n        return json.load(handle)\n\n\ndef longest_zero_run(values: list[float]) -> int:\n    best = 0\n    run = 0\n    for value in values:\n        if float(value) == 0.0:\n            run += 1\n            best = max(best, run)\n        else:\n            run = 0\n    return best\n\n\ndef build_rubric() -> dict[str, Any]:\n    return {\n        \"total_points\": 20,\n        \"criteria\": [\n            {\n                \"name\": \"answer_schema\",\n                \"points\": 4,\n                \"description\": \"Returns the requested compact JSON fields with numeric units implied by field names.\",\n            },\n            {\n                \"name\": \"point_rainfall_metrics\",\n                \"points\": 5,\n                \"description\": \"Computes 0.8 mm point precipitation, a 7-day zero-rain run, and a 13/15 = 0.867 dry-day fraction.\",\n            },\n            {\n                \"name\": \"regional_contrast_metrics\",\n                \"points\": 4,\n                \"description\": \"Uses the three regional means 45.3, 68.2, and 109.0 mm to compute a 74.2 mm mean and 56.7 minimum regional/source ratio.\",\n            },\n            {\n                \"name\": \"threshold_test\",\n                \"points\": 4,\n                \"description\": \"Applies all three thresholds: point_total_mm <= 1.0, zero_run_days >= 7, and min_regional_ratio >= 50.\",\n            },\n            {\n                \"name\": \"computed_consequence\",\n                \"points\": 2,\n                \"description\": \"Concludes washout_downgrade_fails because the source point remains very dry despite wet regional summaries.\",\n            },\n            {\n                \"name\": \"bounded_interpretation\",\n                \"points\": 1,\n                \"description\": \"Keeps the interpretation to the computed rainfall contrast without broad event narration or unsupported impact claims.\",\n            },\n        ],\n    }\n\n\ndef main() -> None:\n    root = package_dir()\n\n    event_meta = read_json(root, SOURCE_FILES[0])\n    anchor = read_json(root, SOURCE_FILES[1])\n    point = read_json(root, SOURCE_FILES[2])\n    era5 = read_json(root, SOURCE_FILES[3])\n    gpm = read_json(root, SOURCE_FILES[4])\n    chirps = read_json(root, SOURCE_FILES[5])\n\n    point_rain = [float(value) for value in point[\"daily\"][\"precipitation_sum\"]]\n    point_total = round(sum(point_rain), 1)\n    zero_run = longest_zero_run(point_rain)\n    dry_days = sum(1 for value in point_rain if value == 0.0)\n    day_count = len(point_rain)\n    dry_fraction = round(dry_days / day_count, 3)\n\n    regional_means_raw = [\n        float(gpm[\"stats\"][\"gpm_event_precip_mm_mean\"]),\n        float(era5[\"stats\"][\"precipitation_sum_mm_mean\"]),\n        float(chirps[\"stats\"][\"chirps_event_precip_mm_mean\"]),\n    ]\n    regional_means = [round(value, 1) for value in sorted(regional_means_raw)]\n    regional_mean = round(sum(regional_means_raw) / len(regional_means_raw), 1)\n    min_regional_ratio = round(min(regional_means_raw) / point_total, 1)\n\n    thresholds = {\n        \"point_total_lte_mm\": 1.0,\n        \"zero_run_gte_days\": 7,\n        \"min_regional_ratio_gte\": 50.0,\n    }\n    answer = (\n        \"washout_downgrade_fails\"\n        if point_total <= thresholds[\"point_total_lte_mm\"]\n        and zero_run >= thresholds[\"zero_run_gte_days\"]\n        and min_regional_ratio >= thresholds[\"min_regional_ratio_gte\"]\n        else \"washout_downgrade_passes\"\n    )\n\n    output = {\n        \"schema_version\": \"1.0\",\n        \"task_id\": TASK_ID,\n        \"event_id\": EVENT_ID,\n        \"task_type\": \"numeric\",\n        \"target_family\": \"indonesia_haze_rain_washout_contrast_ledger\",\n        \"evaluation_mode\": \"deterministic\",\n        \"difficulty_level\": \"L3\",\n        \"primary_gt\": {\n            \"answer\": answer,\n            \"point_total_mm\": point_total,\n            \"zero_run_days\": zero_run,\n            \"dry_day_fraction\": dry_fraction,\n            \"regional_mean_mm\": regional_mean,\n            \"min_regional_ratio\": min_regional_ratio,\n            \"thresholds\": thresholds,\n            \"tolerances\": {\"mm\": 0.1, \"ratio\": 0.1, \"fraction\": 0.001},\n        },\n        \"event\": {\n            \"name\": anchor[\"event_name\"],\n            \"hazard_family\": event_meta[\"hazard_family\"],\n            \"window\": [\n                anchor[\"temporal_window\"][\"start_date\"],\n                anchor[\"temporal_window\"][\"end_date\"],\n            ],\n            \"region\": anchor[\"spatial_window\"][\"location_text\"],\n        },\n        \"computed_values\": {\n            \"point_window\": [point[\"daily\"][\"time\"][0], point[\"daily\"][\"time\"][-1]],\n            \"point_day_count\": day_count,\n            \"point_dry_days\": dry_days,\n            \"regional_means_mm_sorted\": regional_means,\n            \"rule_passes\": {\n                \"point_total_lte_1mm\": point_total <= thresholds[\"point_total_lte_mm\"],\n                \"zero_run_gte_7days\": zero_run >= thresholds[\"zero_run_gte_days\"],\n                \"min_regional_ratio_gte_50\": min_regional_ratio\n                >= thresholds[\"min_regional_ratio_gte\"],\n            },\n        },\n        \"decision_rule\": {\n            \"formulae\": {\n                \"point_total_mm\": \"sum(point daily precipitation)\",\n                \"zero_run_days\": \"longest consecutive run where point daily precipitation equals 0 mm\",\n                \"dry_day_fraction\": \"zero-rain day count / point day count\",\n                \"regional_mean_mm\": \"mean of the three regional event-window precipitation means\",\n                \"min_regional_ratio\": \"minimum regional precipitation mean / point_total_mm\",\n            },\n            \"conclusion\": \"The downgrade fails only when all three numeric thresholds are met.\",\n        },\n        \"rubric\": build_rubric(),\n        \"provenance\": {\n            \"computed_by\": \"compute_gt.py\",\n            \"source_files\": SOURCE_FILES,\n        },\n    }\n\n    out_path = Path(__file__).resolve().parent / \"computed_gt.json\"\n    out_path.write_text(json.dumps(output, indent=2, ensure_ascii=True) + \"\\n\", encoding=\"utf-8\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
